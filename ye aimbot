local FOV = 120
local Smoothness = 0.18
local AimPart = "Head"
local MaxDistance = 1000 -- 👉 最大锁定距离（单位：stud）

local circle = Drawing.new("Circle")
circle.Thickness = 2
circle.Color = Color3.fromRGB(128,0,128)
circle.Filled = false
circle.Radius = FOV

local function isAlive(p)
    local c = p.Character
    local h = c and c:FindFirstChild("Humanoid")
    return h and h.Health > 0
end

local function isVisible(p, part)
    if not ESP_SETTINGS.WallCheck then return true end

    local rayParams = RaycastParams.new()
    rayParams.FilterDescendantsInstances = {localPlayer.Character}
    rayParams.FilterType = Enum.RaycastFilterType.Blacklist

    local result = workspace:Raycast(
        Camera.CFrame.Position,
        (part.Position - Camera.CFrame.Position),
        rayParams
    )

    return result and result.Instance:IsDescendantOf(p.Character)
end

local function getTarget()
    local closest = nil
    local shortest = math.huge
    local center = Camera.ViewportSize / 2

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= localPlayer and isAlive(p) then

            if ESP_SETTINGS.TeamCheck and p.Team == localPlayer.Team then
                continue
            end

            local part = p.Character and p.Character:FindFirstChild(AimPart)
if part then
    
    local camPos = Camera.CFrame.Position
    local offset = part.Position - camPos
    local distance = offset.Magnitude

-- 👉 距离检测开关
if ESP_SETTINGS.DistanceCheck and distance > MaxDistance then
    continue
end
    -- ✅ 👉 默认开启：背后不锁（视角方向检测）
    local directionUnit = distance > 0 and offset.Unit or Vector3.zero
local dot = Camera.CFrame.LookVector:Dot(directionUnit)
    if dot < 0.2 then
        continue
    end
                local pos, visible = Camera:WorldToViewportPoint(part.Position)
                local dist = (Vector2.new(pos.X,pos.Y) - center).Magnitude

                if visible and dist < FOV and dist < shortest and isVisible(p, part) then
                    shortest = dist
                    closest = p
                end
            end
        end
    end

    return closest
end
