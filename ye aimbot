    btn.TextSize = 13
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.Parent = contentFrame
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 10)

    local indicator = Instance.new("Frame", btn)
    indicator.Size = UDim2.new(0, 30, 0, 16)
    indicator.Position = UDim2.new(1, -38, 0.5, -8)
    indicator.BackgroundColor3 = ESP_SETTINGS[settingKey] and Color3.fromRGB(48, 209, 88) or Color3.fromRGB(90, 90, 90)
    Instance.new("UICorner", indicator).CornerRadius = UDim.new(1, 0)
    
    local dot = Instance.new("Frame", indicator)
    dot.Size = UDim2.new(0, 12, 0, 12)
    dot.Position = ESP_SETTINGS[settingKey] and UDim2.new(1, -14, 0.5, -6) or UDim2.new(0, 2, 0.5, -6)
    dot.BackgroundColor3 = Color3.new(1, 1, 1)
    Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)

    btn.MouseButton1Click:Connect(function()
        ESP_SETTINGS[settingKey] = not ESP_SETTINGS[settingKey]
        TweenService:Create(indicator, TweenInfo.new(0.3), {
            BackgroundColor3 = ESP_SETTINGS[settingKey] and Color3.fromRGB(48, 209, 88) or Color3.fromRGB(90, 90, 90)
        }):Play()
        dot:TweenPosition(
            ESP_SETTINGS[settingKey] and UDim2.new(1, -14, 0.5, -6) or UDim2.new(0, 2, 0.5, -6),
            "Out", "Back", 0.3, true
        )
    end)
end

