-- ==========================================
-- 拖拽（修复多指抽搐版）
-- ==========================================

local isDragging = false
local dragStart, startPos
local activeTouch = nil

mainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 
    or (input.UserInputType == Enum.UserInputType.Touch and not activeTouch) then

        isDragging = true
        dragStart = input.Position
        startPos = mainFrame.Position

        -- 记录触摸
        if input.UserInputType == Enum.UserInputType.Touch then
            activeTouch = input
        end

        -- 果冻动画
        local baseWidth = 230
        local baseHeight = ESP_SETTINGS.Minimized and 50 or 290
        TweenService:Create(mainFrame, TweenInfo.new(0.4, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), {
            Size = UDim2.new(0, baseWidth + 15, 0, baseHeight + 15),
            BackgroundTransparency = 0.35
        }):Play()

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then

                if input.UserInputType == Enum.UserInputType.Touch then
                    if input == activeTouch then
                        activeTouch = nil
                        isDragging = false
                    end
                else
                    isDragging = false
                end

                local finalHeight = ESP_SETTINGS.Minimized and 50 or 290
                TweenService:Create(mainFrame, TweenInfo.new(0.5, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), {
                    Size = UDim2.new(0, 230, 0, finalHeight),
                    BackgroundTransparency = 0.5
                }):Play()
            end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if not isDragging then return end

    -- 只允许当前手指控制
    if input.UserInputType == Enum.UserInputType.Touch and input ~= activeTouch then
        return
    end

    local delta = input.Position - dragStart

    mainFrame.Position = UDim2.new(
        startPos.X.Scale,
        startPos.X.Offset + delta.X,
        startPos.Y.Scale,
        startPos.Y.Offset + delta.Y
    )
end)
miniBtn.MouseButton1Click:Connect(function()
    ESP_SETTINGS.Minimized = not ESP_SETTINGS.Minimized

    -- 显示/隐藏内容
    contentFrame.Visible = not ESP_SETTINGS.Minimized

    -- 动画尺寸
    local targetSize = ESP_SETTINGS.Minimized 
        and UDim2.new(0, 230, 0, 50) 
        or UDim2.new(0, 230, 0, 290)

    TweenService:Create(mainFrame, TweenInfo.new(0.6, Enum.EasingStyle.Elastic), {
        Size = targetSize
    }):Play()

    -- 按钮文字切换
    miniBtn.Text = ESP_SETTINGS.Minimized and "+" or "−"
end)
