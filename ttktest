local function createBeamTracer(startPos, endPos)
	if not Config.ShowTracers then return end
	
	local beam = Instance.new("Beam")
	for k, v in pairs(beamTemplate) do
		beam[k] = v
	end
	beam.Color = ColorSequence.new(tracerColor)
	beam.Transparency = NumberSequence.new(tracerTransparency)
	beam.Width0 = 3.0
	beam.Width1 = 3.0
	
	local att0 = Instance.new("Attachment")
	att0.CFrame = CFrame.new(startPos)
	att0.Parent = workspace.Terrain
	
	local att1 = Instance.new("Attachment")
	att1.CFrame = CFrame.new(endPos)
	att1.Parent = workspace.Terrain
	
	beam.Attachment0 = att0
	beam.Attachment1 = att1
	beam.Parent = beamFolder
	
	task.delay(tracerLifetime, function()
		local fadeElapsed = 0
		local fadeConn
		fadeConn = RunService.Heartbeat:Connect(function(dt)
			fadeElapsed = fadeElapsed + dt
			local alpha = math.clamp(fadeElapsed / 0.2, 0, 1)
			beam.Transparency = NumberSequence.new(tracerTransparency + (1 - tracerTransparency) * alpha)
			if fadeElapsed >= 0.2 then
				fadeConn:Disconnect()
				att0:Destroy()
				att1:Destroy()
				beam:Destroy()
			end
		end)
	end)
end

local function createLayeredGlow(part, mainColor, glowColor, transparency)
	local isHead = part.Name == "Head"
	
	local baseColor = Color3.new(glowColor.R * 5, glowColor.G * 5, glowColor.B * 5)
	
	local glowAdornment
	if isHead then
		glowAdornment = Instance.new("CylinderHandleAdornment")
		glowAdornment.Height = part.Size.Y + 0.03
		glowAdornment.Radius = (part.Size.X * 0.5) + 0.03
		glowAdornment.CFrame = CFrame.new(Vector3.new(0, 0, 0), Vector3.new(0, 1, 0))
	else
		glowAdornment = Instance.new("BoxHandleAdornment")
		glowAdornment.Size = part.Size + Vector3.new(0.03, 0.03, 0.03)
	end
	
	glowAdornment.Name = "Chams"
	glowAdornment.AlwaysOnTop = true
	glowAdornment.ZIndex = isHead and 10 or 9
	glowAdornment.Adornee = part
	glowAdornment.Color3 = baseColor
	glowAdornment.Transparency = math.clamp(-1 + transparency, -1, 1)
	glowAdornment.Shading = Enum.AdornShading.XRayShaded
	glowAdornment.Parent = part
	
	local mainAdornment
	if isHead then
		mainAdornment = Instance.new("CylinderHandleAdornment")
		mainAdornment.Height = part.Size.Y + 0.02
		mainAdornment.Radius = (part.Size.X * 0.5) + 0.02
		mainAdornment.CFrame = CFrame.new(Vector3.new(0, 0, 0), Vector3.new(0, 1, 0))
	else
		mainAdornment = Instance.new("BoxHandleAdornment")
		mainAdornment.Size = part.Size + Vector3.new(0.02, 0.02, 0.02)
	end
	
	mainAdornment.Name = "Chams"
	mainAdornment.AlwaysOnTop = true
	mainAdornment.ZIndex = 10
	mainAdornment.Adornee = part
	mainAdornment.Color3 = mainColor
	mainAdornment.Transparency = math.clamp(0.3 + transparency, 0, 1)
	mainAdornment.Parent = part
	
	return glowAdornment, mainAdornment
end

local function createHitModel(targetChar, hitPos, targetUserId)
	if not Config.ShowHitModels then return end
	if not targetChar then return end
	
	local clonedModel = targetChar:Clone()
	clonedModel.Name = "HitClone"
	clonedModel.Parent = hitModelFolder
	
	if not hitModelsByPlayer[targetUserId] then
		hitModelsByPlayer[targetUserId] = {}
	end
	
	local mainColor = Color3.new(0, 0, 0)
	local glowColor = Color3.new(1, 1, 1)
	
	for _, part in ipairs(clonedModel:GetDescendants()) do
		if part:IsA("BasePart") then
			createLayeredGlow(part, mainColor, glowColor, 0.3)
		end
		
		if part:IsA("Script") or part:IsA("LocalScript") or part:IsA("ModuleScript") then
			part:Destroy()
		end
		
		if part:IsA("Humanoid") then
			part:Destroy()
		end
	end
	
	if clonedModel.PrimaryPart then
		clonedModel:SetPrimaryPartCFrame(CFrame.new(hitPos))
	elseif clonedModel:FindFirstChild("HumanoidRootPart") then
		clonedModel.HumanoidRootPart.CFrame = CFrame.new(hitPos)
	end
	
	table.insert(hitModelsByPlayer[targetUserId], 1, clonedModel)
	
	for i, oldModel in ipairs(hitModelsByPlayer[targetUserId]) do
		local baseTransparency = 0.3
		local transparencyAdd = (i - 1) * 0.5
		local finalTransparency = baseTransparency + transparencyAdd
		
		for _, part in ipairs(oldModel:GetDescendants()) do
			if part:IsA("BasePart") then
				for _, adornment in ipairs(part:GetChildren()) do
					if adornment.Name == "Chams" then
						if adornment:IsA("BoxHandleAdornment") or adornment:IsA("CylinderHandleAdornment") then
							if adornment.ZIndex < 10 then
								adornment.Transparency = math.clamp(-1 + finalTransparency, -1, 1)
							else
								adornment.Transparency = math.clamp(finalTransparency, 0, 1)
							end
						end
					end
				end
			end
		end
	end
	
	task.delay(5, function()
		clonedModel:Destroy()
		if hitModelsByPlayer[targetUserId] then
			for i, model in ipairs(hitModelsByPlayer[targetUserId]) do
				if model == clonedModel then
					table.remove(hitModelsByPlayer[targetUserId], i)
					break
				end
			end
		end
	end)
end

