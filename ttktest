local function IsAlive(plr)
	local character = plr.Character
	if not character then return false end
	
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then return false end
	
	return true
end

local function IsDead(part)
	local check = part
	while check and check ~= workspace do
		if check:GetAttribute("Dead") == true then
			return true
		end
		check = check.Parent
	end
	return false
end

local function IsVisible(targetPart)
	if not Config.VisibleCheck then return true end
	
	local character = player.Character
	if not character then return false end
	
	local origin = camera.CFrame.Position
	local direction = (targetPart.Position - origin)
	
	local raycastParams = RaycastParams.new()
	raycastParams.FilterType = Enum.RaycastFilterType.Exclude
	raycastParams.FilterDescendantsInstances = {character, camera}
	
	local result = workspace:Raycast(origin, direction, raycastParams)
	
	if not result then return true end
	
	if result.Instance:IsDescendantOf(targetPart.Parent) then
		return true
	end
	
	return false
end

local function GetClosestPlayer()
	local closestPlayer = nil
	local shortestDistance = math.huge
	
	for _, tagged in ipairs(CollectionService:GetTagged("MercBodyPart")) do
		if tagged:IsA("BasePart") and tagged.Parent then
			if IsDead(tagged) then continue end
			
			local bodyPartName = tagged:GetAttribute("MercBodyPart")
			if bodyPartName ~= Config.Aimpart then continue end
			
			local ownerId = tagged:GetAttribute("OwnerUserId")
			if not ownerId or ownerId == player.UserId then continue end
			
			local targetPlayer = Players:GetPlayerByUserId(ownerId)
			if not targetPlayer then continue end
			
			if not IsAlive(targetPlayer) then continue end
			
			if not IsVisible(tagged) then continue end
			
			local distance = (tagged.Position - camera.CFrame.Position).Magnitude
			
			if distance < shortestDistance then
				shortestDistance = distance
				closestPlayer = {
					Player = targetPlayer,
					Part = tagged,
					Position = tagged.Position
				}
			end
		end
	end
	
	return closestPlayer
end

-- 【新增修复】用于永固备份游戏武器最原始的初始射速数值
local OriginalFireRates = {}

local function ApplyWeaponMods()
	if not WeaponsRegistry then return end
	
	for weaponName, weaponData in pairs(WeaponsRegistry) do
		if type(weaponData) == "table" then
			if Config.FullAuto and weaponData.FireMode then
				pcall(function() weaponData.FireMode = "Auto" end)
				if weaponData.FireModes then
					pcall(function() weaponData.FireModes = {"Auto", "Semi"} end)
				end
			end
			
			-- 核心修复：永远基于最初的原始数值进行计算或还原
			if weaponData.FireRate then
				if not OriginalFireRates[weaponName] then
					OriginalFireRates[weaponName] = weaponData.FireRate
				end
				
				local baseRate = OriginalFireRates[weaponName]
				if Config.FireRateMultiplier then
					pcall(function() weaponData.FireRate = baseRate / Config.FireRateMultiplier end)
				else
					pcall(function() weaponData.FireRate = baseRate end) -- 关闭时完美还原
				end
			end
		end
	end
end

ApplyWeaponMods()

local GunController
pcall(function()
	GunController = require(ReplicatedStorage.Modules.Client.Controllers.GunController)
end)

local function ApplyGunControllerMods()
	if not GunController then return end

	if GunController.Weapon then
		local weapon = GunController.Weapon
		if weapon then
			if Config.FullAuto then
				weapon.FireMode = "auto"
			end
			
			-- 核心修复：实时控制层的动态射速重刷与还原
			local weaponName = weapon.Name
			if weaponName and OriginalFireRates[weaponName] then
				local baseRate = OriginalFireRates[weaponName]
				if Config.FireRateMultiplier then
					weapon.FireRate = baseRate / Config.FireRateMultiplier
				else
					weapon.FireRate = baseRate -- 关闭时完美还原
				end
			end

			if Config.InfiniteMagAmmo and weapon.MagAmmo ~= nil then
				local maxAmmo = weapon.MaxMagSize or 30
				weapon.MagAmmo = maxAmmo
			end
		end
	end
end

RunService.Heartbeat:Connect(function()
	ApplyGunControllerMods()
	
	if Config.InfiniteMagAmmo then
		pcall(function()
			local GC = require(ReplicatedStorage.Modules.Client.Controllers.GunController)
			if GC and GC.Weapon then
				local weapon = GC.Weapon
				if weapon and weapon.MagAmmo ~= nil then
					local maxAmmo = weapon.MaxMagSize or 30
					weapon.MagAmmo = maxAmmo
				end
			end
		end)
	end
	
	if Config.Enabled and GunController and GunController.FireWeapon then
		local target = GetClosestPlayer()
		if target then
			if GunController.Weapon and GunController.Weapon.FireMode ~= "auto" then
				GunController.Weapon.FireMode = "auto"
			end
			
			local didFire = GunController:FireWeapon()
			
			if didFire and target then
				local character = player.Character
				if character then
					local root = character:FindFirstChild("HumanoidRootPart")
					if root then
						createBeamTracer(root.Position, target.Position)
					end
				end
				
				local isHeadshot = (target.Part.Name == "Head")
				createHitmarker(target.Position, isHeadshot)
				
				local targetChar = target.Player.Character
				if targetChar then
					local ownerId = target.Part:GetAttribute("OwnerUserId")
					createHitModel(targetChar, target.Position, ownerId)
				end
			end
		end
	end
end)

local BulletController
pcall(function()
	BulletController = require(ReplicatedStorage.Modules.Client.Controllers.BulletController)
end)

if BulletController and BulletController.Discharge then
	local originalDischarge = BulletController.Discharge
	
	BulletController.Discharge = function(self, weaponName, eyePosition, fireDirection, muzzleWorldPosition, ...)
		if Config.Enabled then
			local target = GetClosestPlayer()
			
			if target then
				local targetPosition = target.Position
				local newDirection = (targetPosition - eyePosition).Unit
				fireDirection = newDirection
			end
		end
		
		return originalDischarge(self, weaponName, eyePosition, fireDirection, muzzleWorldPosition, ...)
	end
end

