local HitmarkerConfig = {
	Enabled = false,            -- 击中提示反馈开关
	Scale = 2.0,
	NormalSize = 16,
	HeadshotSize = 26,
	NormalColor = Color3.fromRGB(255, 255, 255),
	HeadshotColor = Color3.fromRGB(255, 60, 60),
	Duration = 0.28,
}

local activeHitmarkers = {}
local hitmarkerConnection = nil

local function createHitmarker(worldPosition, isHeadshot)
	if not HitmarkerConfig.Enabled then return end
	
	local hud = playerGui:FindFirstChild("HUD")
	if not hud then
		hud = Instance.new("ScreenGui")
		hud.Name = "HUD"
		hud.ResetOnSpawn = false
		hud.Parent = playerGui
	end
	
	if not camera then return end
	
	local screenPos, onScreen = camera:WorldToViewportPoint(worldPosition)
	if not onScreen or screenPos.Z <= 0 then return end
	
	local baseSize = isHeadshot and HitmarkerConfig.HeadshotSize or HitmarkerConfig.NormalSize
	local finalSize = baseSize * HitmarkerConfig.Scale
	
	local frame = Instance.new("Frame")
	frame.Name = isHeadshot and "HitmarkerHeadshot" or "Hitmarker"
	frame.BackgroundTransparency = 1
	frame.BorderSizePixel = 0
	frame.AnchorPoint = Vector2.new(0.5, 0.5)
	frame.Size = UDim2.fromOffset(finalSize, finalSize)
	frame.Position = UDim2.fromOffset(screenPos.X, screenPos.Y)
	frame.Visible = true
	
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(1, 0)
	corner.Parent = frame
	
	local stroke = Instance.new("UIStroke")
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.LineJoinMode = Enum.LineJoinMode.Round
	stroke.Color = isHeadshot and HitmarkerConfig.HeadshotColor or HitmarkerConfig.NormalColor
	stroke.Thickness = (isHeadshot and 2.25 or 1.5) * HitmarkerConfig.Scale
	stroke.Transparency = 0
	stroke.Parent = frame
	
	local scale = Instance.new("UIScale")
	scale.Scale = 0.1
	scale.Parent = frame
	
	frame.Parent = hud
	
	local hitmarkerData = {
		ring = frame,
		stroke = stroke,
		scale = scale,
		worldPos = worldPosition,
		bornAt = os.clock()
	}
	
	table.insert(activeHitmarkers, hitmarkerData)
	
	if not hitmarkerConnection then
		hitmarkerConnection = RunService.RenderStepped:Connect(function()
			local currentTime = os.clock()
			local cam = workspace.CurrentCamera
			
			for i = #activeHitmarkers, 1, -1 do
				local marker = activeHitmarkers[i]
				
				if not marker.ring.Parent then
					table.remove(activeHitmarkers, i)
				else
					local elapsed = currentTime - marker.bornAt
					local progress = elapsed / HitmarkerConfig.Duration
					
					local easeOut = 1 - progress
					local easeCubic = 1 - easeOut * easeOut * easeOut
					marker.scale.Scale = easeCubic * 1.9 + 0.1
					
					if elapsed >= HitmarkerConfig.Duration then
						marker.ring:Destroy()
						table.remove(activeHitmarkers, i)
					else
						if elapsed >= 0.08 then
							local fadeProgress = (elapsed - 0.08) / 0.2
							marker.stroke.Transparency = math.clamp(fadeProgress, 0, 1)
						end
						
						if cam then
							local sp, os = cam:WorldToViewportPoint(marker.worldPos)
							if os and sp.Z > 0 then
								marker.ring.Position = UDim2.fromOffset(sp.X, sp.Y)
								marker.ring.Visible = true
							else
								marker.ring.Visible = false
							end
						end
					end
				end
			end
			
			if #activeHitmarkers == 0 and hitmarkerConnection then
				hitmarkerConnection:Disconnect()
				hitmarkerConnection = nil
			end
		end)
	end
end

local tracerColor = Color3.fromRGB(215, 127, 156)
local tracerTransparency = 0
local tracerLifetime = 5

local beamTemplate = {
	Texture = "rbxassetid://446111271",
	TextureMode = Enum.TextureMode.Wrap,
	TextureLength = 10,
	LightEmission = 1,
