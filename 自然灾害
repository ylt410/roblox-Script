local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local CoreGui = game:GetService("CoreGui")
local HttpService = game:GetService("HttpService")
local LocalPlayer = Players.LocalPlayer

-- ====================== 开屏感谢（轻薄版：小字、无黑底、透明渐现） ======================
task.spawn(function()
    local sg = Instance.new("ScreenGui", CoreGui)
    sg.Name = "DisasterWelcome"
    sg.ResetOnSpawn = false
    
    local label = Instance.new("TextLabel", sg)
    label.Size = UDim2.new(0.8, 0, 0.25, 0)  -- 缩小高度
    label.Position = UDim2.new(0.1, 0, 0.35, 0)
    label.BackgroundTransparency = 1  -- 无黑底，纯透明
    label.TextColor3 = Color3.fromRGB(0, 255, 120)
    label.TextScaled = true
    label.TextSize = 18  -- 字小一点
    label.Font = Enum.Font.Gotham
    label.TextStrokeTransparency = 0.5  -- 轻微描边
    label.TextStrokeColor3 = Color3.new(0,0,0)
    label.TextWrapped = true
    label.Text = "感谢 "..LocalPlayer.Name.."\n使用飞行 + 穿墙 + 黑洞\n自然灾害终极整合脚本\n享受毁灭吧！"
    
    -- 渐现效果
    label.TextTransparency = 1
    label:TweenPosition(UDim2.new(0.1,0,0.35,0), "Out", "Quad", 0.5, true)
    label:TweenSize(UDim2.new(0.8,0,0.25,0), "Out", "Quad", 0.5, true)
    label:TweenTransparencyAndSize(0, UDim2.new(0.8,0,0.25,0), "Out", "Quad", 1, true)  -- 1秒渐现
    
    task.wait(4)  -- 显示4秒
    label:TweenTransparencyAndSize(1, UDim2.new(0.8,0,0.01,0), "In", "Quad", 0.8, true)  -- 渐隐
    task.wait(0.8)
    sg:Destroy()
end)

