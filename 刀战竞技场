-- =================== 创建 Tab ===================
local TabAC = Window:Tab({
    Title = "AC",
    Icon = "info",
    Locked = false,
})

-- =================== 服务 ===================
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Camera = workspace.CurrentCamera
local LocalPlayer = Players.LocalPlayer

local Remote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("ReplicateShot")

-- =================== 状态变量 ===================
local rageEnabled = false
local connection = nil
local fireRate = 0.05
local lastShoot = 0

-- =================== 获取目标 ===================
local function getBestTarget()
    local target = nil
    local lastDist = math.huge

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local hitbox = plr.Character:FindFirstChild("_Hitbox")
            local head = hitbox and hitbox:FindFirstChild("Head") or plr.Character:FindFirstChild("Head")
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")

            if head and hum and hum.Health > 0 then
                local dist = (head.Position - Camera.CFrame.Position).Magnitude
                if dist < lastDist then
                    lastDist = dist
                    target = head
                end
            end
        end
    end

    return target
end

-- =================== 射击 ===================
local function fireRage()
    local now = tick()
    if now - lastShoot < fireRate then return end

    local targetPart = getBestTarget()
    if not targetPart then return end

    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("Head") then return end

    local origin = char.Head.Position
    local hitPos = targetPart.Position
    local direction = (hitPos - origin).Unit

    local args = {
        [1] = hitPos,
        [2] = targetPart,
        [3] = direction
    }

    Remote:FireServer(unpack(args))

    lastShoot = now
end

-- =================== Toggle ===================
TabAC:Toggle({
    Title = "自动锁头",
    Desc = "最近目标自动射击",
    Type = "Checkbox",
    Value = false,

    Callback = function(state)
        rageEnabled = state

        -- 断开旧连接
        if connection then
            connection:Disconnect()
            connection = nil
        end

        if state then
            connection = RunService.Heartbeat:Connect(function()
                pcall(function()
                    if rageEnabled then
                        fireRage()
                    end
                end)
            end)
        end
    end
})

-- =================== 射速滑条 ===================
TabAC:Slider({
    Title = "射速",
    Desc = "越小越快",
    Step = 0.01,
    Value = {
        Min = 0.01,
        Max = 0.2,
        Default = 0.05,
    },
    Callback = function(val)
        fireRate = val
    end
})