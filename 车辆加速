local dragToggle = false
local dragStart = nil
local startPos = nil
local activeDragInput = nil

MidDragZone.InputBegan:Connect(function(input)
	if isDestroyed then
		return
	end

	local inputType = input.UserInputType

	if inputType == Enum.UserInputType.MouseButton1
		or inputType == Enum.UserInputType.Touch then

		dragToggle = true
		dragStart = input.Position
		startPos = Flyon.Position
		activeDragInput = input

		input.Changed:Connect(function()
			if input.UserInputState ==
				Enum.UserInputState.End then

				dragToggle = false
				activeDragInput = nil
			end
		end)
	end
end)

inputChangedConnection =
	UserInputService.InputChanged:Connect(function(input)

	if isDestroyed
		or not dragToggle
		or not dragStart
		or not startPos then

		return
	end

	local isMouseMovement =
		input.UserInputType ==
		Enum.UserInputType.MouseMovement

	local isActiveTouch =
		input.UserInputType ==
			Enum.UserInputType.Touch
		and input == activeDragInput

	if isMouseMovement or isActiveTouch then
		local delta = input.Position - dragStart

		Flyon.Position = UDim2.new(
			startPos.X.Scale,
			startPos.X.Offset + delta.X,
			startPos.Y.Scale,
			startPos.Y.Offset + delta.Y
		)
	end
end)

-- ==========================================
-- 11. 物理核心
-- ==========================================

local function startRenderLoop()
	renderConnection = disconnectConnection(renderConnection)

	renderConnection =
		RunService.RenderStepped:Connect(function(deltaTime)

		if isDestroyed or not isDriving then
			return
		end

		local humanoid = getHumanoid()

		if not humanoid
			or not currentVehicleSeat
			or humanoid.SeatPart ~= currentVehicleSeat
			or not currentVehicleSeat.Parent
			or not currentVehicleRoot
			or not currentVehicleRoot.Parent
			or not currentVehicleRoot:IsDescendantOf(workspace)
			or not bvInstance
			or not bvInstance.Parent
			or not bgInstance
			or not bgInstance.Parent
			or not rootToSeatRotation then

			stopDriving()
			return
		end

		local camera = workspace.CurrentCamera

		if not camera then
			return
		end

		local speedValue =
			tonumber(Speed.Text)
			or DEFAULT_SPEED

		speedValue = math.clamp(
			speedValue,
			0,
			MAX_ALLOWED_SPEED
		)

		-- ======================================
		-- 11.1 获取相机水平朝向
		-- ======================================

		local seatFallbackForward =
			getSafeFlatUnit(
				currentVehicleSeat.CFrame.LookVector,
				Vector3.new(0, 0, -1)
			)

		local cameraForward =
			getSafeFlatUnit(
				camera.CFrame.LookVector,
				seatFallbackForward
			)

		local cameraRight =
			getSafeFlatUnit(
				camera.CFrame.RightVector,
				Vector3.new(1, 0, 0)
			)

		-- ======================================
		-- 11.2 只控制车头左右方向
		-- ======================================

		local desiredSeatRotation =
			CFrame.lookAt(
				ZERO_VECTOR,
				cameraForward,
				WORLD_UP
			).Rotation

		local desiredRootRotation =
			desiredSeatRotation
			* rootToSeatRotation:Inverse()

		local desiredRootCFrame =
			CFrame.new(currentVehicleRoot.Position)
			* desiredRootRotation

		local assemblyMass =
			currentVehicleRoot.AssemblyMass

		local yawTorqueValue = math.clamp(
			assemblyMass * YAW_TORQUE_PER_MASS,
			MIN_YAW_TORQUE,
			MAX_YAW_TORQUE
		)

		-- 只有 Y 轴有旋转力量。
		-- X/Z 为 0，不压制正常上下坡和自然倾斜。
		bgInstance.MaxTorque = Vector3.new(
			0,
			yawTorqueValue,
			0
		)

		bgInstance.P = YAW_GYRO_POWER
		bgInstance.D = YAW_GYRO_DAMPING
		bgInstance.CFrame = desiredRootCFrame

		-- ======================================
		-- 11.3 只有真正倒扣才翻正
		-- ======================================

		local seatUpY =
			currentVehicleSeat.CFrame.UpVector.Y

		local currentTime = time()

		if seatUpY <= FLIP_TRIGGER_UP_Y
			and currentTime - lastFlipTime >=
				FLIP_COOLDOWN then

			lastFlipTime = currentTime

			local savedVelocity =
				currentVehicleRoot.AssemblyLinearVelocity

			local correctedPosition =
				currentVehicleRoot.Position
				+ Vector3.new(
					0,
					FLIP_LIFT_HEIGHT,
					0
				)

			currentVehicleRoot.CFrame =
				CFrame.new(correctedPosition)
				* desiredRootRotation

			currentVehicleRoot.AssemblyAngularVelocity =
				ZERO_VECTOR

			currentVehicleRoot.AssemblyLinearVelocity =
				Vector3.new(
					savedVelocity.X,
					math.min(savedVelocity.Y, 0),
					savedVelocity.Z
				)
		end

		-- ======================================
		-- 11.4 计算水平移动速度
		-- ======================================

		local targetVelocity = ZERO_VECTOR

		if driveDirection ~= 0 then
			targetVelocity +=
				cameraForward
				* speedValue
				* driveDirection
		end

		if lateralEnabled
			and strafeDirection ~= 0 then

			targetVelocity +=
				cameraRight
				* speedValue
				* strafeDirection
		end

		if targetVelocity.Magnitude > speedValue
			and speedValue > 0 then

			targetVelocity =
				targetVelocity.Unit * speedValue
		end

		targetVelocity = Vector3.new(
			targetVelocity.X,
			0,
			targetVelocity.Z
		)

		-- ======================================
		-- 11.5 速度模式
		-- ======================================

		if linearAccelerationEnabled then
			-- 勾选“线性加速”后，使用原有的平滑加速和减速。
			local commandRate

			if targetVelocity.Magnitude >
				currentCommandVelocity.Magnitude then

				commandRate = ACCELERATION_RATE
			else
				commandRate = DECELERATION_RATE
			end

			currentCommandVelocity =
				moveVectorToward(
					currentCommandVelocity,
					targetVelocity,
					commandRate * deltaTime
				)
		else
			-- 默认模式：直接达到目标速度。
			-- 松开按钮后也会立即回到 0。
			currentCommandVelocity =
				targetVelocity
		end

		currentCommandVelocity = Vector3.new(
			currentCommandVelocity.X,
			0,
			currentCommandVelocity.Z
		)

		-- ======================================
		-- 11.6 水平动力
		-- ======================================

		local horizontalForce = math.max(
			assemblyMass * FORCE_PER_MASS,
			MIN_HORIZONTAL_FORCE
		)

		-- Y 轴永远不施力。
		bvInstance.MaxForce = Vector3.new(
			horizontalForce,
			0,
			horizontalForce
		)

		bvInstance.Velocity =
			currentCommandVelocity
	end)
end

-- ==========================================
-- 12. 启动与关闭引擎
-- ==========================================

EnableBtn.MouseButton1Click:Connect(function()
	if isDestroyed then
		return
	end

	if isDriving then
		stopDriving()
		return
	end

	local humanoid = getHumanoid()
	local vehicleSeat = getCurrentVehicleSeat()

	if not humanoid or not vehicleSeat then
		showTemporaryError("请先坐进车辆")
		return
	end

	if not createPhysicsInstances(vehicleSeat) then
		showTemporaryError("车辆连接失败")
		return
	end

	isDriving = true
	setEngineUi(true)

	seatConnection = disconnectConnection(seatConnection)

	-- 玩家下车或换车后立刻断开旧车。
	seatConnection =
		humanoid:GetPropertyChangedSignal("SeatPart")
		:Connect(function()

			if isDestroyed or not isDriving then
				return
			end

			if humanoid.SeatPart ~=
				currentVehicleSeat then

				stopDriving()
			end
		end)

	startRenderLoop()
end)

-- ==========================================
-- 13. 长按按钮控制
-- ==========================================

local function isValidPressInput(input)
	return input.UserInputType ==
			Enum.UserInputType.MouseButton1
		or input.UserInputType ==
			Enum.UserInputType.Touch
end

local function bindHoldButton(
	button,
	onPressed,
	onReleased
)
	button.InputBegan:Connect(function(input)
		if not isDestroyed
			and isValidPressInput(input) then

			onPressed()
		end
	end)

	button.InputEnded:Connect(function(input)
		if isValidPressInput(input) then
			onReleased()
		end
	end)

	button.MouseLeave:Connect(function()
		onReleased()
	end)
end

bindHoldButton(
	W,
	function()
		driveDirection = 1
	end,
	function()
		if driveDirection == 1 then
			driveDirection = 0
		end
	end
)

bindHoldButton(
	S,
	function()
		driveDirection = -1
	end,
	function()
		if driveDirection == -1 then
			driveDirection = 0
		end
	end
)

bindHoldButton(
	A,
	function()
		strafeDirection = -1
	end,
	function()
		if strafeDirection == -1 then
			strafeDirection = 0
		end
	end
)

bindHoldButton(
	D,
	function()
		strafeDirection = 1
	end,
	function()
		if strafeDirection == 1 then
			strafeDirection = 0
		end
	end
)

