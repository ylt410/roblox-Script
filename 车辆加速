local function setEngineUi(active)
	if active then
		EnableBtn.Text = "引擎运行中（已开启）"
		EnableBtn.BackgroundColor3 =
			Color3.fromRGB(0, 245, 212)

		EnableBtn.TextColor3 =
			Color3.fromRGB(20, 20, 25)

		Flyon.Visible = true
	else
		EnableBtn.Text = "启动引擎（已关闭）"
		EnableBtn.BackgroundColor3 =
			Color3.fromRGB(0, 180, 216)

		EnableBtn.TextColor3 =
			Color3.fromRGB(255, 255, 255)

		Flyon.Visible = false
	end
end

local function stopDriving()
	if not isDriving
		and not renderConnection
		and not seatConnection
		and not bvInstance
		and not bgInstance then

		return
	end

	isDriving = false

	driveDirection = 0
	strafeDirection = 0
	currentCommandVelocity = ZERO_VECTOR

	-- 运行期连接必须在每次关闭引擎时断开。
	renderConnection = disconnectConnection(renderConnection)
	seatConnection = disconnectConnection(seatConnection)

	destroyPhysicsInstances()

	if not isDestroyed
		and EnableBtn
		and EnableBtn.Parent then

		setEngineUi(false)
	end
end

local function showTemporaryError(text)
	EnableBtn.Text = text
	EnableBtn.BackgroundColor3 =
		Color3.fromRGB(255, 71, 87)

	EnableBtn.TextColor3 =
		Color3.fromRGB(255, 255, 255)

	task.delay(1, function()
		if not isDestroyed
			and EnableBtn
			and EnableBtn.Parent
			and not isDriving then

			setEngineUi(false)
		end
	end)
end

