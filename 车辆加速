local function cleanupAll()
	if isDestroyed then
		return
	end

	isDestroyed = true
	isDriving = false

	driveDirection = 0
	strafeDirection = 0
	currentCommandVelocity = ZERO_VECTOR

	renderConnection = disconnectConnection(renderConnection)
	seatConnection = disconnectConnection(seatConnection)
	inputChangedConnection = disconnectConnection(inputChangedConnection)
	characterRemovingConnection =
		disconnectConnection(characterRemovingConnection)

	destroyPhysicsInstances()

	if Flymguiv2 and Flymguiv2.Parent then
		Flymguiv2:Destroy()
	end

	if sharedEnvironment
		and sharedEnvironment[GLOBAL_CLEANUP_KEY] == cleanupAll then

		sharedEnvironment[GLOBAL_CLEANUP_KEY] = nil
	end
end

-- 注册完整清理函数，供重复执行脚本时调用。
if sharedEnvironment then
	sharedEnvironment[GLOBAL_CLEANUP_KEY] = cleanupAll
end

