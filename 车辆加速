stopDriving = function()
	if not isDriving
		and not renderConnection
		and not seatConnection
		and not sitConnection
		and not platformStandConnection
		and not bvInstance
		and not turnInstance then

		return
	end

	isDriving = false

	driveDirection = 0
	strafeDirection = 0
	currentCommandVelocity = ZERO_VECTOR

	-- 运行期连接必须在每次关闭引擎时断开。
	renderConnection = disconnectConnection(renderConnection)
	seatConnection = disconnectConnection(seatConnection)
	sitConnection = disconnectConnection(sitConnection)
