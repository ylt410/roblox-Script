-- ==========================================
-- 11. 物理核心
-- ==========================================

local function startRenderLoop()
	renderConnection = disconnectConnection(renderConnection)

	renderConnection =
		RunService.RenderStepped:Connect(function(deltaTime)

		if isDestroyed or not isDriving then
			return
		end

		-- 每帧核对当前应该控制人物还是车辆。
		-- 即使 SeatPart 事件延迟，也不会继续控制旧车。
		syncControlTarget(false)

		if isDestroyed or not isDriving then
			return
		end

		local humanoid = getHumanoid()

		if not humanoid
			or not currentControlType
			or not hasValidPhysicsTarget() then

			stopDriving()
			return
		end

		if currentControlType == "Vehicle"
			and (
				not currentVehicleReferencePart
				or not currentVehicleReferencePart.Parent
				or not rootToSeatRotation
			) then

			syncControlTarget(true)
			return
		end

		if currentControlType == "Character" then
			local detectedVehicleRoot =
				resolveVehicleTarget(
					humanoid,
					false
				)

			if detectedVehicleRoot then
				syncControlTarget(true)
				return
			end
		end

		local camera = workspace.CurrentCamera

		if not camera then
			return
		end

		local speedValue =
			tonumber(Speed.Text)
			or DEFAULT_SPEED

		speedValue = math.clamp(
			speedValue,
			0,
			MAX_ALLOWED_SPEED
		)

		local fallbackForward

		if currentControlType == "Vehicle"
			and currentVehicleReferencePart then

			fallbackForward =
				currentVehicleReferencePart.CFrame.LookVector
		else
			fallbackForward =
				currentVehicleRoot.CFrame.LookVector
		end

		local cameraForward =
			getSafeFlatUnit(
				camera.CFrame.LookVector,
				fallbackForward
			)

		local cameraRight =
			getSafeFlatUnit(
				camera.CFrame.RightVector,
				Vector3.new(1, 0, 0)
			)

		local assemblyMass =
			currentVehicleRoot.AssemblyMass

		-- ======================================
		-- 11.1 当前目标朝向
		-- ======================================

		if currentControlType == "Vehicle" then
			-- 车辆只控制世界 Y 轴转向。
			-- 不干预正常上下坡和自然侧倾。
			local desiredSeatRotation =
				CFrame.lookAt(
					ZERO_VECTOR,
					cameraForward,
					WORLD_UP
				).Rotation

			local desiredRootRotation =
				desiredSeatRotation
				* rootToSeatRotation:Inverse()

			local desiredRootCFrame =
				CFrame.new(currentVehicleRoot.Position)
				* desiredRootRotation

			local yawTorqueValue = math.clamp(
				assemblyMass * YAW_TORQUE_PER_MASS,
				MIN_YAW_TORQUE,
				MAX_YAW_TORQUE
			)

			local targetYawVelocity =
				calculateTargetYawVelocity(
					currentVehicleReferencePart.CFrame.LookVector,
					cameraForward
				)

			updateSteeringYawVelocity(
				targetYawVelocity,
				deltaTime
			)

			turnInstance.MaxTorque = Vector3.new(
				0,
				yawTorqueValue,
				0
			)
			turnInstance.P = VEHICLE_TURN_POWER
			turnInstance.AngularVelocity = Vector3.new(
				0,
				currentSteeringYawVelocity,
				0
			)

			-- 只有车辆真正倒扣时才翻正。
			local referenceUpY =
				currentVehicleReferencePart.CFrame.UpVector.Y

			local currentTime = time()

			if currentVehicleFlipEnabled
				and referenceUpY <= FLIP_TRIGGER_UP_Y
				and currentTime - lastFlipTime >=
					FLIP_COOLDOWN then

				lastFlipTime = currentTime

				local savedVelocity =
					currentVehicleRoot.AssemblyLinearVelocity

				local correctedPosition =
					currentVehicleRoot.Position
					+ Vector3.new(
						0,
						FLIP_LIFT_HEIGHT,
						0
					)

				currentVehicleRoot.CFrame =
					CFrame.new(correctedPosition)
					* desiredRootRotation

				currentVehicleRoot.AssemblyAngularVelocity =
					ZERO_VECTOR

				currentSteeringYawVelocity = 0
				turnInstance.AngularVelocity =
					ZERO_VECTOR

				currentVehicleRoot.AssemblyLinearVelocity =
					Vector3.new(
						savedVelocity.X,
						math.min(savedVelocity.Y, 0),
						savedVelocity.Z
					)
			end
		else
			-- 人物模式让人物朝向相机水平方向。
			-- 不控制 X/Z 旋转，也不修改垂直速度。
			local targetYawVelocity =
				calculateTargetYawVelocity(
					currentVehicleRoot.CFrame.LookVector,
					cameraForward
				)

			updateSteeringYawVelocity(
				targetYawVelocity,
				deltaTime
			)

			turnInstance.MaxTorque = Vector3.new(
				0,
				CHARACTER_YAW_TORQUE,
				0
			)
			turnInstance.P = CHARACTER_TURN_POWER
			turnInstance.AngularVelocity = Vector3.new(
				0,
				currentSteeringYawVelocity,
				0
			)
		end

		-- ======================================
		-- 11.2 计算水平移动速度
		-- ======================================

		local targetVelocity = ZERO_VECTOR

		if driveDirection ~= 0 then
			targetVelocity +=
				cameraForward
				* speedValue
				* driveDirection
		end

		if lateralEnabled
			and strafeDirection ~= 0 then

			targetVelocity +=
				cameraRight
				* speedValue
				* strafeDirection
		end

		if targetVelocity.Magnitude > speedValue
			and speedValue > 0 then

			targetVelocity =
				targetVelocity.Unit * speedValue
		end

		targetVelocity = Vector3.new(
			targetVelocity.X,
			0,
			targetVelocity.Z
		)

		-- ======================================
		-- 11.3 速度模式
		-- ======================================

		if linearAccelerationEnabled then
			local commandRate

			if targetVelocity.Magnitude >
				currentCommandVelocity.Magnitude then

				commandRate = ACCELERATION_RATE
			else
				commandRate = DECELERATION_RATE
			end

			currentCommandVelocity =
				moveVectorToward(
					currentCommandVelocity,
					targetVelocity,
					commandRate * deltaTime
				)
		else
			-- 默认直接达到目标速度。
			currentCommandVelocity =
				targetVelocity
		end

		currentCommandVelocity = Vector3.new(
			currentCommandVelocity.X,
			0,
			currentCommandVelocity.Z
		)

		-- ======================================
		-- 11.4 水平动力
		-- ======================================

		local horizontalForce = math.max(
			assemblyMass * FORCE_PER_MASS,
			MIN_HORIZONTAL_FORCE
		)

		-- Y 轴永远不施力。
		bvInstance.MaxForce = Vector3.new(
			horizontalForce,
			0,
			horizontalForce
		)

		bvInstance.Velocity =
			currentCommandVelocity
	end)
end

-- ==========================================
-- 12. 启动与关闭引擎
-- ==========================================

EnableBtn.MouseButton1Click:Connect(function()
	if isDestroyed then
		return
	end

	if isDriving then
		stopDriving()
		return
	end

	local humanoid = getHumanoid()

	if not humanoid then
		showTemporaryError("角色尚未加载")
		return
	end

	local vehicleRoot,
		referencePart,
		seatPart,
		detectionKind,
		flipEnabled =
		resolveVehicleTarget(
			humanoid,
			true
		)

	local targetCreated = false

	if vehicleDetectionEnabled then
		if not vehicleRoot or not referencePart then
			showTemporaryError("未检测到车辆")
			return
		end

		targetCreated =
			createVehiclePhysicsInstances(
				vehicleRoot,
				referencePart,
				seatPart,
				detectionKind,
				flipEnabled
			)
	else
		if vehicleRoot and referencePart then
			targetCreated =
				createVehiclePhysicsInstances(
					vehicleRoot,
					referencePart,
					seatPart,
					detectionKind,
					flipEnabled
				)
		else
			targetCreated =
				createCharacterPhysicsInstances(
					humanoid
				)
		end
	end

	if not targetCreated then
		showTemporaryError("控制目标连接失败")
		return
	end

	isDriving = true
	setEngineUi(true)

	seatConnection = disconnectConnection(seatConnection)
	sitConnection = disconnectConnection(sitConnection)
	platformStandConnection =
		disconnectConnection(platformStandConnection)

	local function refreshTargetImmediately()
		if isDestroyed or not isDriving then
			return
		end

		syncControlTarget(true)
	end

	-- 标准 Seat/VehicleSeat 的变化会立即触发。
	seatConnection =
		humanoid:GetPropertyChangedSignal("SeatPart")
		:Connect(refreshTargetImmediately)

	-- 部分自定义车辆只修改 Sit 或 PlatformStand。
	sitConnection =
		humanoid:GetPropertyChangedSignal("Sit")
		:Connect(refreshTargetImmediately)

	platformStandConnection =
		humanoid:GetPropertyChangedSignal("PlatformStand")
		:Connect(refreshTargetImmediately)

	startRenderLoop()
end)

-- ==========================================
-- 13. 长按按钮控制
-- ==========================================

local function isValidPressInput(input)
	return input.UserInputType ==
			Enum.UserInputType.MouseButton1
		or input.UserInputType ==
			Enum.UserInputType.Touch
end

local function bindHoldButton(
	button,
	onPressed,
	onReleased
)
	button.InputBegan:Connect(function(input)
		if not isDestroyed
			and isValidPressInput(input) then

			onPressed()
		end
	end)

	button.InputEnded:Connect(function(input)
		if isValidPressInput(input) then
			onReleased()
		end
	end)

	button.MouseLeave:Connect(function()
		onReleased()
	end)
end

bindHoldButton(
	W,
	function()
		driveDirection = 1
	end,
	function()
		if driveDirection == 1 then
			driveDirection = 0
		end
	end
)

bindHoldButton(
	S,
	function()
		driveDirection = -1
	end,
	function()
		if driveDirection == -1 then
			driveDirection = 0
		end
	end
)

bindHoldButton(
	A,
	function()
		strafeDirection = -1
	end,
	function()
		if strafeDirection == -1 then
			strafeDirection = 0
		end
	end
)

bindHoldButton(
	D,
	function()
		strafeDirection = 1
	end,
	function()
		if strafeDirection == 1 then
			strafeDirection = 0
		end
	end
)

