local function destroyPhysicsInstances()
	if bvInstance then
		bvInstance:Destroy()
		bvInstance = nil
	end

	if turnInstance then
		turnInstance:Destroy()
		turnInstance = nil
	end

	restoreHumanoidAutoRotate()

	currentControlType = nil
	currentVehicleSeat = nil
	currentVehicleReferencePart = nil
	currentVehicleRoot = nil
	rootToSeatRotation = nil
	currentVehicleDetectionKind = nil
	currentVehicleFlipEnabled = false

	currentCommandVelocity = ZERO_VECTOR
	currentSteeringYawVelocity = 0
	lastFlipTime = 0
end

local function createBasePhysicsInstances(rootPart)
	if not rootPart
		or not rootPart:IsA("BasePart") then

		return false
	end

	bvInstance = Instance.new("BodyVelocity")
	bvInstance.Name = "驾驶矩阵_水平动力"
	bvInstance.MaxForce = Vector3.new(
		MIN_HORIZONTAL_FORCE,
		0,
		MIN_HORIZONTAL_FORCE
	)
	bvInstance.P = VELOCITY_POWER
	bvInstance.Velocity = ZERO_VECTOR
	bvInstance.Parent = rootPart

	turnInstance = Instance.new("BodyAngularVelocity")
	turnInstance.Name = "驾驶矩阵_水平转向"
	turnInstance.MaxTorque = Vector3.new(
		0,
		MIN_YAW_TORQUE,
		0
	)
	turnInstance.P = VEHICLE_TURN_POWER
	turnInstance.AngularVelocity = ZERO_VECTOR
	turnInstance.Parent = rootPart

	currentCommandVelocity = ZERO_VECTOR
	currentSteeringYawVelocity = 0

	return true
end

local function createVehiclePhysicsInstances(
	vehicleRoot,
	referencePart,
	seatPart,
	detectionKind,
	flipEnabled
)
	destroyPhysicsInstances()

	if not vehicleRoot
		or not vehicleRoot:IsA("BasePart")
		or vehicleRoot.Anchored
		or not referencePart
		or not referencePart:IsA("BasePart") then

		return false
	end

	currentControlType = "Vehicle"
	currentVehicleSeat = seatPart
	currentVehicleReferencePart = referencePart
	currentVehicleRoot = vehicleRoot
	currentVehicleDetectionKind = detectionKind
	currentVehicleFlipEnabled = flipEnabled == true

	-- 保存物理根与车头参考零件之间的固定方向差。
	rootToSeatRotation =
		currentVehicleRoot.CFrame.Rotation:ToObjectSpace(
			currentVehicleReferencePart.CFrame.Rotation
		)

	if not createBasePhysicsInstances(currentVehicleRoot) then
		destroyPhysicsInstances()
		return false
	end

	return true
end

local function createCharacterPhysicsInstances(humanoid)
	destroyPhysicsInstances()

	if not humanoid or not humanoid.Parent then
		return false
	end

	local characterRoot =
		getCharacterRoot(humanoid)

	if not characterRoot
		or not characterRoot:IsA("BasePart") then

		return false
	end

	currentControlType = "Character"
	currentVehicleSeat = nil
	currentVehicleReferencePart = nil
	currentVehicleRoot = characterRoot
	rootToSeatRotation = nil
	currentVehicleDetectionKind = nil
	currentVehicleFlipEnabled = false

	controlledHumanoid = humanoid
	previousHumanoidAutoRotate = humanoid.AutoRotate
	humanoid.AutoRotate = false

	if not createBasePhysicsInstances(currentVehicleRoot) then
		destroyPhysicsInstances()
		return false
	end

	return true
end

local function hasValidPhysicsTarget()
	return currentVehicleRoot
		and currentVehicleRoot.Parent
		and currentVehicleRoot:IsDescendantOf(workspace)
		and bvInstance
		and bvInstance.Parent == currentVehicleRoot
		and turnInstance
		and turnInstance.Parent == currentVehicleRoot
end

local function syncControlTarget(forceExternalScan)
	if not isDriving or isDestroyed then
		return
	end

	local humanoid = getHumanoid()

	if not humanoid then
		stopDriving()
		return
	end

	local vehicleRoot,
		referencePart,
		seatPart,
		detectionKind,
		flipEnabled =
		resolveVehicleTarget(
			humanoid,
			forceExternalScan == true
		)

	if vehicleDetectionEnabled then
		-- 检测开启：必须检测到标准或自定义车辆。
		if not vehicleRoot or not referencePart then
			stopDriving()
			return
		end
	else
		-- 检测关闭：检测到车辆就控制车辆，否则控制人物。
		if not vehicleRoot or not referencePart then
			local characterRoot =
				getCharacterRoot(humanoid)

			if currentControlType ~= "Character"
				or currentVehicleRoot ~= characterRoot
				or controlledHumanoid ~= humanoid
				or not hasValidPhysicsTarget() then

				-- 进入人物模式前会销毁旧车上的所有物理实例。
				if not createCharacterPhysicsInstances(humanoid) then
					stopDriving()
				end
			end

			return
		end
	end

	if currentControlType ~= "Vehicle"
		or currentVehicleRoot ~= vehicleRoot
		or currentVehicleReferencePart ~= referencePart
		or currentVehicleSeat ~= seatPart
		or currentVehicleDetectionKind ~= detectionKind
		or not hasValidPhysicsTarget() then

		-- 切换到新目标前，会先彻底释放人物或上一辆车。
		if not createVehiclePhysicsInstances(
			vehicleRoot,
			referencePart,
			seatPart,
			detectionKind,
			flipEnabled
		) then

			stopDriving()
		end
	else
		currentVehicleFlipEnabled =
			flipEnabled == true
	end
end

