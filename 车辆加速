-- ==========================================
-- 4. 通用函数
-- ==========================================

local function applyRoundCorners(instance, radius)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius or 6)
	corner.Parent = instance
end

local function getHumanoid()
	local character = LocalPlayer.Character

	if not character then
		return nil
	end

	return character:FindFirstChildOfClass("Humanoid")
end

local function getCurrentVehicleSeat()
	local humanoid = getHumanoid()

	if not humanoid then
		return nil
	end

	local seatPart = humanoid.SeatPart

	if seatPart and seatPart:IsA("VehicleSeat") then
		return seatPart
	end

	return nil
end

local function getSafeFlatUnit(vector, fallback)
	local flatVector = Vector3.new(
		vector.X,
		0,
		vector.Z
	)

	if flatVector.Magnitude > 0.001 then
		return flatVector.Unit
	end

	if fallback then
		local flatFallback = Vector3.new(
			fallback.X,
			0,
			fallback.Z
		)

		if flatFallback.Magnitude > 0.001 then
			return flatFallback.Unit
		end
	end

	return Vector3.new(0, 0, -1)
end

local function moveVectorToward(current, target, maxDelta)
	local difference = target - current
	local distance = difference.Magnitude

	if distance <= maxDelta or distance <= 0.001 then
		return target
	end

	return current + difference.Unit * maxDelta
end

local function disconnectConnection(connection)
	if connection then
		connection:Disconnect()
	end

	return nil
end

local function destroyPhysicsInstances()
	if bvInstance then
		bvInstance:Destroy()
		bvInstance = nil
	end

	if bgInstance then
		bgInstance:Destroy()
		bgInstance = nil
	end

	currentVehicleSeat = nil
	currentVehicleRoot = nil
	rootToSeatRotation = nil

	currentCommandVelocity = ZERO_VECTOR
	lastFlipTime = 0
end

local function createPhysicsInstances(vehicleSeat)
	destroyPhysicsInstances()

	if not vehicleSeat
		or not vehicleSeat:IsA("VehicleSeat") then

		return false
	end

	currentVehicleSeat = vehicleSeat

	-- 推力和旋转必须作用于整辆车的 AssemblyRootPart。
	currentVehicleRoot =
		vehicleSeat.AssemblyRootPart or vehicleSeat

	if not currentVehicleRoot
		or not currentVehicleRoot:IsA("BasePart") then

		currentVehicleSeat = nil
		currentVehicleRoot = nil
		return false
	end

	-- 保存整车根部和座椅车头之间的固定方向差。
	rootToSeatRotation =
		currentVehicleRoot.CFrame.Rotation:ToObjectSpace(
			currentVehicleSeat.CFrame.Rotation
		)

	bvInstance = Instance.new("BodyVelocity")
	bvInstance.Name = "驾驶矩阵_水平动力"

	-- Y 轴推力永久为 0，防止碰撞飞升和空中悬浮。
	bvInstance.MaxForce = Vector3.new(
		MIN_HORIZONTAL_FORCE,
		0,
		MIN_HORIZONTAL_FORCE
	)

	bvInstance.P = VELOCITY_POWER
	bvInstance.Velocity = ZERO_VECTOR
	bvInstance.Parent = currentVehicleRoot

	bgInstance = Instance.new("BodyGyro")
	bgInstance.Name = "驾驶矩阵_车头转向"

	-- 这里只控制世界 Y 轴旋转。
	-- 不控制 X/Z，因此车辆可以正常上下坡和自然侧倾。
	bgInstance.MaxTorque = Vector3.new(
		0,
		MIN_YAW_TORQUE,
		0
	)

	bgInstance.P = YAW_GYRO_POWER
	bgInstance.D = YAW_GYRO_DAMPING
	bgInstance.CFrame = currentVehicleRoot.CFrame
	bgInstance.Parent = currentVehicleRoot

	currentCommandVelocity = ZERO_VECTOR

	return true
end

