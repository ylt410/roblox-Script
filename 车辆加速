local function applyRoundCorners(instance, radius)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius or 6)
	corner.Parent = instance
end

local function getHumanoid()
	local character = LocalPlayer.Character

	if not character then
		return nil
	end

	return character:FindFirstChildOfClass("Humanoid")
end

local function getCharacterRoot(humanoid)
	if not humanoid or not humanoid.Parent then
		return nil
	end

	return humanoid.RootPart
		or humanoid.Parent:FindFirstChild("HumanoidRootPart")
end

local function getCurrentSeatPart(humanoid)
	if not humanoid then
		return nil
	end

	local seatPart = humanoid.SeatPart

	-- Humanoid.SeatPart 可能是普通 Seat，也可能是 VehicleSeat。
	if seatPart
		and seatPart:IsA("BasePart")
		and (
			seatPart:IsA("Seat")
			or seatPart:IsA("VehicleSeat")
		) then

		return seatPart
	end

	return nil
end

local function getVehicleReferenceScore(part, characterRoot)
	if not part or not part:IsA("BasePart") then
		return -math.huge
	end

	local score = 0
	local lowerName = string.lower(part.Name)

	if part:IsA("VehicleSeat") then
		score += 10000
	elseif part:IsA("Seat") then
		score += 9000
	end

	if string.find(lowerName, "driver", 1, true)
		or string.find(lowerName, "drive", 1, true)
		or string.find(part.Name, "驾驶", 1, true) then

		score += 5000
	end

	if string.find(lowerName, "seat", 1, true)
		or string.find(part.Name, "座", 1, true) then

		score += 4000
	end

	if string.find(lowerName, "chassis", 1, true)
		or string.find(lowerName, "body", 1, true)
		or string.find(lowerName, "frame", 1, true)
		or string.find(lowerName, "main", 1, true)
		or string.find(lowerName, "root", 1, true)
		or string.find(lowerName, "base", 1, true)
		or string.find(part.Name, "底盘", 1, true)
		or string.find(part.Name, "车身", 1, true) then

		score += 2500
	end

	if string.find(lowerName, "wheel", 1, true)
		or string.find(lowerName, "tire", 1, true)
		or string.find(lowerName, "tyre", 1, true)
		or string.find(part.Name, "车轮", 1, true)
		or string.find(part.Name, "轮胎", 1, true) then

		score -= 10000
	end

	local volume =
		part.Size.X * part.Size.Y * part.Size.Z

	score += math.min(volume, 1500)

	if characterRoot then
		score -= math.min(
			(part.Position - characterRoot.Position).Magnitude * 4,
			400
		)
	end

	return score
end

local function addExternalCandidate(
	candidates,
	part,
	character
)
	if not part
		or not part:IsA("BasePart")
		or not part.Parent
		or part:IsDescendantOf(character)
		or not part:IsDescendantOf(workspace) then

		return
	end

	local assemblyRoot =
		part.AssemblyRootPart or part

	if not assemblyRoot
		or not assemblyRoot:IsA("BasePart")
		or not assemblyRoot.Parent
		or assemblyRoot.Anchored then

		return
	end

	candidates[part] = true
end

local function addJointExternalPart(
	candidates,
	character,
	part0,
	part1
)
	if part0
		and part0:IsA("BasePart")
		and part0:IsDescendantOf(character) then

		addExternalCandidate(
			candidates,
			part1,
			character
		)
	elseif part1
		and part1:IsA("BasePart")
		and part1:IsDescendantOf(character) then

		addExternalCandidate(
			candidates,
			part0,
			character
		)
	end
end

local function scanExternalVehicleTarget(humanoid)
	local character = humanoid and humanoid.Parent
	local characterRoot = getCharacterRoot(humanoid)

	if not character or not characterRoot then
		return nil, nil, false
	end

	local candidates = {}

	-- 如果人物根部的 AssemblyRootPart 已经在角色模型外，
	-- 说明人物正与一个外部刚性装配体连成整体。
	local directAssemblyRoot =
		characterRoot.AssemblyRootPart

	if directAssemblyRoot
		and not directAssemblyRoot:IsDescendantOf(character) then

		addExternalCandidate(
			candidates,
			directAssemblyRoot,
			character
		)
	end

	-- 检查与人物根部刚性连接的完整装配体。
	local connectedOk, connectedParts =
		pcall(function()
			return characterRoot:GetConnectedParts(true)
		end)

	if connectedOk and connectedParts then
		for _, part in ipairs(connectedParts) do
			addExternalCandidate(
				candidates,
				part,
				character
			)
		end
	end

	-- 补充检查角色模型内指向外部零件的刚性连接。
	-- 主要覆盖 Weld、WeldConstraint、Motor6D 和 RigidConstraint。
	for _, descendant in ipairs(character:GetDescendants()) do
		if descendant:IsA("WeldConstraint")
			or descendant:IsA("Weld")
			or descendant:IsA("Motor6D") then

			addJointExternalPart(
				candidates,
				character,
				descendant.Part0,
				descendant.Part1
			)
		elseif descendant:IsA("RigidConstraint") then
			local attachment0 = descendant.Attachment0
			local attachment1 = descendant.Attachment1

			local part0 =
				attachment0 and attachment0.Parent

			local part1 =
				attachment1 and attachment1.Parent

			addJointExternalPart(
				candidates,
				character,
				part0,
				part1
			)
		end
	end

	local bestPart = nil
	local bestScore = -math.huge

	for part in pairs(candidates) do
		local score =
			getVehicleReferenceScore(
				part,
				characterRoot
			)

		if score > bestScore then
			bestScore = score
			bestPart = part
		end
	end

	if not bestPart then
		return nil, nil, false
	end

	local vehicleRoot =
		bestPart.AssemblyRootPart or bestPart

	if not vehicleRoot
		or not vehicleRoot:IsA("BasePart")
		or vehicleRoot.Anchored then

		return nil, nil, false
	end

	-- 只有 Seat 或明显的车身/底盘参考零件才启用倒扣翻正。
	-- 避免误选旋转中的轮子后反复触发翻车修复。
	local flipEnabled =
		bestPart:IsA("Seat")
		or bestPart:IsA("VehicleSeat")
		or bestScore >= 2000

	return vehicleRoot, bestPart, flipEnabled
end

local function getExternalVehicleTarget(
	humanoid,
	forceScan
)
	local now = time()

	if not forceScan
		and now - lastExternalVehicleScanTime <
			EXTERNAL_VEHICLE_SCAN_INTERVAL then

		if cachedExternalVehicleRoot
			and cachedExternalVehicleRoot.Parent
			and cachedExternalReferencePart
			and cachedExternalReferencePart.Parent then

			return
				cachedExternalVehicleRoot,
				cachedExternalReferencePart,
				cachedExternalFlipEnabled
		end

		return nil, nil, false
	end

	lastExternalVehicleScanTime = now

	cachedExternalVehicleRoot,
	cachedExternalReferencePart,
	cachedExternalFlipEnabled =
		scanExternalVehicleTarget(humanoid)

	return
		cachedExternalVehicleRoot,
		cachedExternalReferencePart,
		cachedExternalFlipEnabled
end

local function resolveVehicleTarget(
	humanoid,
	forceExternalScan
)
	local seatPart =
		getCurrentSeatPart(humanoid)

	if seatPart then
		local vehicleRoot =
			seatPart.AssemblyRootPart or seatPart

		if vehicleRoot
			and vehicleRoot:IsA("BasePart")
			and not vehicleRoot.Anchored then

			return
				vehicleRoot,
				seatPart,
				seatPart,
				"Seat",
				true
		end
	end

	local externalRoot,
		externalReference,
		externalFlipEnabled =
		getExternalVehicleTarget(
			humanoid,
			forceExternalScan
		)

	if externalRoot and externalReference then
		return
			externalRoot,
			externalReference,
			nil,
			"ExternalAssembly",
			externalFlipEnabled
	end

	return nil, nil, nil, nil, false
end

local function getSafeFlatUnit(vector, fallback)
	local flatVector = Vector3.new(
		vector.X,
		0,
		vector.Z
	)

	if flatVector.Magnitude > 0.001 then
		return flatVector.Unit
	end

	if fallback then
		local flatFallback = Vector3.new(
			fallback.X,
			0,
			fallback.Z
		)

		if flatFallback.Magnitude > 0.001 then
			return flatFallback.Unit
		end
	end

	return Vector3.new(0, 0, -1)
end

local function moveVectorToward(current, target, maxDelta)
	local difference = target - current
	local distance = difference.Magnitude

	if distance <= maxDelta or distance <= 0.001 then
		return target
	end

	return current + difference.Unit * maxDelta
end

local function getSignedYawError(currentForward, targetForward)
	local currentFlat =
		getSafeFlatUnit(
			currentForward,
			Vector3.new(0, 0, -1)
		)

	local targetFlat =
		getSafeFlatUnit(
			targetForward,
			currentFlat
		)

	local dotValue = math.clamp(
		currentFlat:Dot(targetFlat),
		-1,
		1
	)

	local crossY =
		currentFlat:Cross(targetFlat).Y

	return math.atan2(crossY, dotValue)
end

local function calculateTargetYawVelocity(
	currentForward,
	targetForward
)
	local yawError =
		getSignedYawError(
			currentForward,
			targetForward
		)

	local gain
	local maximumRate
	local deadzone

	if linearSteeringEnabled then
		gain = LINEAR_TURN_GAIN
		maximumRate = LINEAR_TURN_MAX_RATE
		deadzone = LINEAR_TURN_DEADZONE
	else
		gain = DIRECT_TURN_GAIN
		maximumRate = DIRECT_TURN_MAX_RATE
		deadzone = DIRECT_TURN_DEADZONE
	end

	if math.abs(yawError) <= deadzone then
		return 0
	end

	local targetRate = math.clamp(
		yawError * gain,
		-maximumRate,
		maximumRate
	)

	-- 大于死区后保留最小转速，避免转向拖到最后完全不动。
	if math.abs(targetRate) < MIN_TURN_RATE then
		targetRate =
			math.sign(targetRate)
			* MIN_TURN_RATE
	end

	return targetRate
end

local function updateSteeringYawVelocity(
	targetYawVelocity,
	deltaTime
)
	local response

	if linearSteeringEnabled then
		response = LINEAR_TURN_RESPONSE
	else
		response = DIRECT_TURN_RESPONSE
	end

	local alpha =
		1 - math.exp(-response * deltaTime)

	currentSteeringYawVelocity +=
		(
			targetYawVelocity
			- currentSteeringYawVelocity
		) * alpha

	if math.abs(currentSteeringYawVelocity) <
		math.rad(0.25)
		and targetYawVelocity == 0 then

		currentSteeringYawVelocity = 0
	end
end

