local function isVisible(p, part)

    if not Camera then return false end  -- ⭐防炸

    if not ESP_SETTINGS.WallCheck then return true end

    local rayParams = RaycastParams.new()
    rayParams.FilterDescendantsInstances = {LocalPlayer.Character}
    rayParams.FilterType = Enum.RaycastFilterType.Blacklist

    local result = workspace:Raycast(
        Camera.CFrame.Position,
        (part.Position - Camera.CFrame.Position),
        rayParams
    )

    return result and result.Instance and result.Instance:IsDescendantOf(p.Character)
end
local function isAlive(p)
    local c = p.Character
    local h = c and c:FindFirstChild("Humanoid")
    return h and h.Health > 0
end
local function getTarget()
    local closest = nil
    local shortest = FOV -- 🔥 只在FOV内找
    local center = Camera.ViewportSize / 2

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and isAlive(p) then

            -- 队伍检测
            if ESP_SETTINGS.TeamCheck and p.Team == LocalPlayer.Team then
                continue
            end

            local part = p.Character and p.Character:FindFirstChild(AimPart)
            if part then
                
                local camPos = Camera.CFrame.Position
                local offset = part.Position - camPos
                local distance = offset.Magnitude

                -- 距离限制
                if distance > MaxDistance then
    continue
end
                -- 背后检测（保留你原逻辑）
                local directionUnit = distance > 0 and offset.Unit or Vector3.zero
                local dot = Camera.CFrame.LookVector:Dot(directionUnit)
                
               local pos, visible = Camera:WorldToViewportPoint(part.Position)
                if not visible then continue end

                local dist = (Vector2.new(pos.X, pos.Y) - center).Magnitude

                -- 🔥 FOV + 最近优先
                if dist < shortest and isVisible(p, part) then
                    shortest = dist
                    closest = p
                end
            end
        end
    end

    return closest
end
