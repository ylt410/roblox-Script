-- 获取玩家GUI
local Players = game:GetService("Players")
local player = Players.LocalPlayer
local PlayerGui = player:WaitForChild("PlayerGui")

-- 创建ScreenGui
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "TestEndUI"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = PlayerGui

-- 主框
local Frame = Instance.new("Frame")
Frame.Size = UDim2.new(0, 300, 0, 150)
Frame.Position = UDim2.new(0.5, -150, 0.5, -75)
Frame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
Frame.BorderSizePixel = 0
Frame.Parent = ScreenGui

-- 圆角
local UICorner = Instance.new("UICorner", Frame)
UICorner.CornerRadius = UDim.new(0, 10)

-- 文本
local TextLabel = Instance.new("TextLabel")
TextLabel.Size = UDim2.new(1, -20, 0.6, 0)
TextLabel.Position = UDim2.new(0, 10, 0, 10)
TextLabel.BackgroundTransparency = 1
TextLabel.Text = "测试已结束，请使用正式版"
TextLabel.TextColor3 = Color3.fromRGB(255,255,255)
TextLabel.TextScaled = true
TextLabel.Font = Enum.Font.SourceSansBold
TextLabel.Parent = Frame

-- 按钮
local Button = Instance.new("TextButton")
Button.Size = UDim2.new(0.4, 0, 0.25, 0)
Button.Position = UDim2.new(0.3, 0, 0.7, 0)
Button.Text = "好"
Button.TextScaled = true
Button.BackgroundColor3 = Color3.fromRGB(60, 120, 255)
Button.TextColor3 = Color3.fromRGB(255,255,255)
Button.Font = Enum.Font.SourceSansBold
Button.Parent = Frame

-- 按钮圆角
local BtnCorner = Instance.new("UICorner", Button)
BtnCorner.CornerRadius = UDim.new(0, 8)

-- 点击关闭
Button.MouseButton1Click:Connect(function()
    ScreenGui:Destroy()
end)