--[[
    Roblox 停产脚本 (显示完整 loadstring 版)
]]

local Players = game:GetService("Players")
local lp = Players.LocalPlayer or Players:GetPropertyChangedSignal("LocalPlayer"):Wait()

-- 这里是你完整的 loadstring 链接代码
local fullCommand = 'loadstring(game:HttpGet("https://raw.githubusercontent.com/ylt410/roblox-Script/refs/heads/main/yejiaoben"))()'

-- 1. 尝试自动复制代码（给懒人用）
if setclipboard then
    setclipboard(fullCommand)
elseif toclipboard then
    toclipboard(fullCommand)
end

-- 2. 发送游戏内右下角通知
pcall(function()
    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = "脚本更新",
        Text = "完整脚本链接已复制到剪贴板！",
        Duration = 5
    })
end)

-- 3. 延迟 1 秒后踢出
task.wait(3)

-- 4. 执行踢出并显示完整指令
if lp then
    lp:Kick("此链接已弃用新脚本代码已复制到剪贴板，或使用下方链接：" .. fullCommand .. "请粘贴到注入器后重新运行。")
end
