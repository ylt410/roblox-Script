-- =================== NPC ESP 模块 ===================
local NPCESP = {
    Enabled = false,
    Color = Color3.fromRGB(0,162,255),
    Highlights = {}
}

local function GetNPCPart(model)
    if not model then return nil end
    if model:FindFirstChild("HumanoidRootPart") then return model.HumanoidRootPart end
    for _, part in pairs(model:GetDescendants()) do
        if part:IsA("BasePart") then return part end
    end
    return nil
end

local function AddNPCESP(model)
    if not model or NPCESP.Highlights[model] then return end
    if not model:FindFirstChildWhichIsA("Humanoid") then return end
    
    -- 等待一下确保Humanoid加载完成
    local humanoid = model:WaitForChild("Humanoid", 2)
    if not humanoid then return end
    
    -- 检查是否是玩家角色
    if Players:GetPlayerFromCharacter(model) then return end
    
    local part = GetNPCPart(model)
    if not part then return end
    
    local hl = Instance.new("Highlight")
    hl.Name = "NPCESP"
    hl.Adornee = model
    hl.FillColor = NPCESP.Color
    hl.OutlineColor = Color3.fromRGB(255,255,255)
    hl.FillTransparency = 0.4
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = model
    NPCESP.Highlights[model] = hl
    
    -- 当NPC被销毁时自动清理
    model.AncestryChanged:Connect(function()
        if not model.Parent then
            RemoveNPCESP(model)
        end
    end)
end

local function RemoveNPCESP(model)
    if NPCESP.Highlights[model] then
        pcall(function() NPCESP.Highlights[model]:Destroy() end)
        NPCESP.Highlights[model] = nil
    end
end

local function UpdateNPCESPColor(color)
    NPCESP.Color = color
    for model, hl in pairs(NPCESP.Highlights) do
        if hl and hl.Parent then hl.FillColor = color end
    end
end

local function ScanAllNPCs()
    -- 使用GetDescendants扫描所有后代对象
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and obj:FindFirstChildWhichIsA("Humanoid") then
            task.spawn(AddNPCESP, obj)
        end
    end
end

local function ToggleNPCESP(state)
    NPCESP.Enabled = state
    if state then
        -- 扫描所有已存在的NPC
        ScanAllNPCs()
        
        -- 使用DescendantAdded检测所有新出现的对象
        if not Connections.NPC then
            Connections.NPC = workspace.DescendantAdded:Connect(function(child)
                -- 等待一下确保对象加载完成
                task.wait(0.1)
                if child:IsA("Model") and child:FindFirstChildWhichIsA("Humanoid") then
                    AddNPCESP(child)
                end
            end)
        end
    else
        for model, _ in pairs(NPCESP.Highlights) do RemoveNPCESP(model) end
        if Connections.NPC then Connections.NPC:Disconnect() Connections.NPC=nil end
    end
end

-- =================== 互动对象 ESP 模块 ===================
local InteractESP = {
    Enabled = false,
    Color = Color3.fromRGB(0,255,0),
    Highlights = {}
}

local function IsInteractive(obj)
    return obj:IsA("ProximityPrompt") or obj:IsA("ClickDetector")
end

local function FindInteractiveObject(prompt)
    -- 从ProximityPrompt向上查找可交互的对象
    local parent = prompt.Parent
    if not parent then return nil end
    
    -- 如果父对象是BasePart或Model，通常这就是我们要的对象
    if parent:IsA("BasePart") or parent:IsA("Model") then
        return parent
    end
    
    -- 否则继续向上查找
    local current = parent
    while current and current ~= workspace do
        if current:IsA("BasePart") or current:IsA("Model") then
            return current
        end
        current = current.Parent
    end
    
    return nil
end

local function FindAdornPart(target)
    if target:IsA("BasePart") then return target end
    if target:IsA("Model") then
        if target.PrimaryPart then return target.PrimaryPart end
        for _, c in pairs(target:GetDescendants()) do
            if c:IsA("BasePart") then return c end
        end
    end
    return nil
end

local function AddInteractESP(target)
    if not target or InteractESP.Highlights[target] then return end
    if not target:IsA("BasePart") and not target:IsA("Model") then return end
    
    local hl = Instance.new("Highlight")
    hl.Name = "InteractESP"
    hl.Adornee = target
    hl.FillColor = InteractESP.Color
    hl.OutlineColor = Color3.fromRGB(255,255,255)
    hl.FillTransparency = 0.5
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = target
    InteractESP.Highlights[target] = hl

    local adornPart = FindAdornPart(target)
    if adornPart then
        -- 查找ProximityPrompt获取提示文本
        local prompt = target:FindFirstChildWhichIsA("ProximityPrompt") or target:FindFirstDescendantWhichIsA("ProximityPrompt")
        local text = (prompt and prompt.ActionText ~= "" and prompt.ActionText) or "可互动"
        
        local bb = Instance.new("BillboardGui")
        bb.Name = "InteractLabel"
        bb.Adornee = adornPart
        bb.Size = UDim2.new(0,120,0,30)
        bb.StudsOffset = Vector3.new(0,3,0)
        bb.AlwaysOnTop = true
        bb.Parent = adornPart
        
        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1,0,1,0)
        label.BackgroundTransparency = 1
        label.Text = text
        label.TextColor3 = InteractESP.Color
        label.TextStrokeTransparency = 0.5
        label.TextStrokeColor3 = Color3.new(0,0,0)
        label.Font = Enum.Font.SourceSansBold
        label.TextSize = 14
        label.Parent = bb
    end
end

local function RemoveInteractESP(target)
    if InteractESP.Highlights[target] then
        pcall(function() InteractESP.Highlights[target]:Destroy() end)
        InteractESP.Highlights[target] = nil
    end
    for _, v in pairs(target:GetDescendants()) do
        if v:IsA("BillboardGui") and v.Name=="InteractLabel" then 
            pcall(function() v:Destroy() end) 
        end
    end
end

local function UpdateInteractColor(color)
    InteractESP.Color = color
    for target, hl in pairs(InteractESP.Highlights) do
        if hl and hl.Parent then hl.FillColor=color end
        for _, v in pairs(target:GetDescendants()) do
            if v:IsA("BillboardGui") and v.Name=="InteractLabel" then
                local txt = v:FindFirstChildWhichIsA("TextLabel")
                if txt then txt.TextColor3=color end
            end
        end
    end
end

local function ScanAllInteractives()
    -- 扫描所有已存在的互动物体
    for _, obj in pairs(workspace:GetDescendants()) do
        if IsInteractive(obj) then
            -- 找到正确的可交互对象
            local target = FindInteractiveObject(obj)
            if target then
                task.spawn(AddInteractESP, target)
            end
        end
    end
end

local function ToggleInteractESP(state)
    InteractESP.Enabled = state
    if state then
        -- 扫描所有已存在的互动物体
        ScanAllInteractives()
        
        -- 检测新添加的ProximityPrompt或ClickDetector
        if not Connections.Interact then
            Connections.Interact = workspace.DescendantAdded:Connect(function(child)
                task.wait(0.1)
                if IsInteractive(child) then
                    -- 找到正确的可交互对象
                    local target = FindInteractiveObject(child)
                    if target then
                        AddInteractESP(target)
                    end
                end
            end)
        end
    else
        for target,_ in pairs(InteractESP.Highlights) do RemoveInteractESP(target) end
        if Connections.Interact then Connections.Interact:Disconnect() Connections.Interact=nil end
    end
end

