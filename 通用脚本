-- ==================== 夜视 & 去雾（纯实用版） ====================
local NightVisionEnabled = false
local NoFogEnabled = false

local Lighting = game:GetService("Lighting")

local originalLighting = {
    Brightness = Lighting.Brightness,
    Ambient = Lighting.Ambient,
    OutdoorAmbient = Lighting.OutdoorAmbient,
    FogEnd = Lighting.FogEnd,
    FogStart = Lighting.FogStart,
    FogColor = Lighting.FogColor,
    ClockTime = Lighting.ClockTime,
    GlobalShadows = Lighting.GlobalShadows,
    EnvironmentDiffuseScale = Lighting.EnvironmentDiffuseScale or 1,
    EnvironmentSpecularScale = Lighting.EnvironmentSpecularScale or 0,
    ColorShift_Top = Lighting.ColorShift_Top,
    ColorShift_Bottom = Lighting.ColorShift_Bottom
}

local function ApplyNightVision(enable)
    if enable then
        Lighting.Brightness = 12
        Lighting.Ambient = Color3.fromRGB(220, 220, 220)
        Lighting.OutdoorAmbient = Color3.fromRGB(220, 220, 220)
        Lighting.EnvironmentDiffuseScale = 1
        Lighting.EnvironmentSpecularScale = 1
        Lighting.GlobalShadows = false
        Lighting.ClockTime = 12
        Lighting.ColorShift_Top = Color3.new(0,0,0)
        Lighting.ColorShift_Bottom = Color3.new(0,0,0)
        
        OrionLib:MakeNotification({
            Name = "夜视开启",
            Content = "黑夜直接变白天，敌人都看得清",
            Time = 4
        })
    else
        Lighting.Brightness = originalLighting.Brightness
        Lighting.Ambient = originalLighting.Ambient
        Lighting.OutdoorAmbient = originalLighting.OutdoorAmbient
        Lighting.EnvironmentDiffuseScale = originalLighting.EnvironmentDiffuseScale
        Lighting.EnvironmentSpecularScale = originalLighting.EnvironmentSpecularScale
        Lighting.GlobalShadows = originalLighting.GlobalShadows
        Lighting.ClockTime = originalLighting.ClockTime
        Lighting.ColorShift_Top = originalLighting.ColorShift_Top
        Lighting.ColorShift_Bottom = originalLighting.ColorShift_Bottom
        
        OrionLib:MakeNotification({
            Name = "夜视关闭",
            Content = "恢复正常，别闪瞎眼",
            Time = 4
        })
    end
end

local function ApplyNoFog(enable)
    if enable then
        Lighting.FogEnd = math.huge
        Lighting.FogStart = 0
        Lighting.FogColor = Color3.fromRGB(200, 200, 220)
        
        for _, obj in pairs(Lighting:GetChildren()) do
            if obj:IsA("Atmosphere") then
                obj.Density = 0
                obj.Offset = 0
                obj.Glare = 0
                obj.Haze = 0
            end
        end
        
        OrionLib:MakeNotification({
            Name = "去雾开启",
            Content = "雾全没了，视野拉到宇宙尽头",
            Time = 4
        })
    else
        Lighting.FogEnd = originalLighting.FogEnd
        Lighting.FogStart = originalLighting.FogStart
        Lighting.FogColor = originalLighting.FogColor
        
        OrionLib:MakeNotification({
            Name = "去雾关闭",
            Content = "雾气回来了",
            Time = 4
        })
    end
end

game.Players.LocalPlayer.CharacterAdded:Connect(function()
    task.wait(1)
    if NightVisionEnabled then ApplyNightVision(true) end
    if NoFogEnabled then ApplyNoFog(true) end
end)

