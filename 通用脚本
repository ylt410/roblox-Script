-- --------- 稳健加载 Rayfield 与通用通知函数（关键修复点） ----------
local function tryLoadRayfield(retries, waitTime)
    retries = retries or 3
    waitTime = waitTime or 0.5
    local lastErr = nil
    for i = 1, retries do
        local ok, res = pcall(function()
            return loadstring(game:HttpGet('https://sirius.menu/rayfield'))()
        end)
        if ok and res then
            return res
        else
            lastErr = res
            task.wait(waitTime)
        end
    end
    return nil, lastErr
end

