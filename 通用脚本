-- ==================== NPC ESP ====================
local ESPEnabled = false
local highlights = {}
local connections = {}
local npcColor = Color3.fromRGB(0, 162, 255)

local function AddESP(model)
    if not model or not model:FindFirstChild("Humanoid") or not model:FindFirstChild("HumanoidRootPart") then return end
    if game.Players:GetPlayerFromCharacter(model) then return end

    local hl = Instance.new("Highlight")
    hl.Name = "NPCESP"
    hl.Adornee = model
    hl.FillColor = npcColor
    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
    hl.FillTransparency = 0.4
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = model

    highlights[model] = hl
end

local function RemoveESP(model)
    if highlights[model] then
        highlights[model]:Destroy()
        highlights[model] = nil
    end
end

local function UpdateNPCColor(newColor)
    npcColor = newColor
    for model, hl in pairs(highlights) do
        if hl and hl.Parent then
            hl.FillColor = newColor
        end
    end
end

local function ToggleESP(state)
    ESPEnabled = state
    if state then
        for _, obj in pairs(workspace:GetChildren()) do
            if obj:IsA("Model") and obj:FindFirstChildWhichIsA("Humanoid") then
                task.spawn(AddESP, obj)
            end
        end
        connections.desc = workspace.ChildAdded:Connect(function(child)
            task.delay(0.1, function()
                if child:IsA("Model") and child:FindFirstChildWhichIsA("Humanoid") then
                    AddESP(child)
                end
            end)
        end)
    else
        for model, _ in pairs(highlights) do
            RemoveESP(model)
        end
        if connections.desc then connections.desc:Disconnect() connections.desc = nil end
    end
end

