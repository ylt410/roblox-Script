TabNight:CreateToggle({Name="普通夜视",CurrentValue=false,Callback=ApplyNormalNightVision})
TabNight:CreateToggle({Name="超级夜视 (1.5x 增强)",CurrentValue=false,Callback=ApplySuperNightVision})
TabNight:CreateToggle({Name="彻底去雾",CurrentValue=false,Callback=ApplyNoFog})
TabNight:CreateButton({Name="关闭所有夜视/去雾",Callback=function() 
    ApplyNormalNightVision(false) 
    ApplySuperNightVision(false) 
    ApplyNoFog(false) 
end})

