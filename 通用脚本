-- ==================== 互动物体 ESP ====================
local InteractESPEnabled = false
local interactHighlights = {}
local interactConnections = {}
local interactColor = Color3.fromRGB(0, 255, 0)

local function IsInteractive(obj)
    return (obj:IsA("ProximityPrompt") or obj:IsA("ClickDetector")) and obj.Parent
end

local function AddInteractESP(target)
    if not target or interactHighlights[target] then return end
    if not target:IsA("BasePart") and not target:IsA("Model") then return end

    local hl = Instance.new("Highlight")
    hl.Name = "InteractESP"
    hl.Adornee = target
    hl.FillColor = interactColor
    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
    hl.FillTransparency = 0.5
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = target

    interactHighlights[target] = hl

    local prompt = target:FindFirstChild("ProximityPrompt") or target.Parent:FindFirstChild("ProximityPrompt")
    local text = prompt and prompt.ActionText or "可互动"

    local bb = Instance.new("BillboardGui")
    bb.Name = "InteractLabel"
    bb.Adornee = target
    bb.Size = UDim2.new(0, 100, 0, 30)
    bb.StudsOffset = Vector3.new(0, 3, 0)
    bb.AlwaysOnTop = true
    bb.Parent = target
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1,0,1,0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = interactColor
    label.TextStrokeTransparency = 0.5
    label.TextStrokeColor3 = Color3.new(0,0,0)
    label.Font = Enum.Font.SourceSansBold
    label.TextSize = 14
    label.Parent = bb
end

local function RemoveInteractESP(target)
    if interactHighlights[target] then
        interactHighlights[target]:Destroy()
        interactHighlights[target] = nil
    end
    if target:FindFirstChild("InteractLabel") then
        target.InteractLabel:Destroy()
    end
end

local function UpdateInteractColor(newColor)
    interactColor = newColor
    for target, hl in pairs(interactHighlights) do
        if hl and hl.Parent then hl.FillColor = newColor end
        local bb = target:FindFirstChild("InteractLabel")
        if bb and bb:FindFirstChild("TextLabel") then
            bb.TextLabel.TextColor3 = newColor
        end
    end
end

local function ToggleInteractESP(state)
    InteractESPEnabled = state
    if state then
        for _, obj in pairs(workspace:GetDescendants()) do
            if IsInteractive(obj) then
                task.spawn(AddInteractESP, obj.Parent)
            end
        end
        interactConnections.desc = workspace.DescendantAdded:Connect(function(child)
            task.delay(0.1, function()
                if IsInteractive(child) then
                    AddInteractESP(child.Parent)
                end
            end)
        end)
    else
        for target, _ in pairs(interactHighlights) do
            if target and target.Parent then
                RemoveInteractESP(target)
            end
        end
        if interactConnections.desc then interactConnections.desc:Disconnect() interactConnections.desc = nil end
    end
end

