-- 黑名单检测（LocalScript）
-- 放在 StarterPlayerScripts 下即可生效

local Players = game:GetService("Players")
local player = Players.LocalPlayer

-- 黑名单表（可以随时扩展）
local blacklist = {
	["ecxrtue"] = true,
}

-- 检测是否在名单中
if blacklist[player.Name] then
	task.wait(1) -- 等待1秒
	player:Kick("你已被拉黑，无法进入游戏。")
end

