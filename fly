-- ===== 飞行变量 =====
local flying = false
local bv, bg
local renderConn, charRemovingConn

-- 用户可见的“单位速度”，从 1 开始，每次 +1 / -1
local speed = 1
local minSpeed, maxSpeed = 0.1, 200   -- 用户可见速度范围（可调整）
local speedStep = 1                    -- 每次 +1 / -1

-- speedScale：把“1 单位”映射成多少实际 studs/s（你要每 1 更快就调大这个值）
local speedScale = 40                  -- ← 关键：每 1 单位等于 40 studs/s（你可以改成更大）
local function effectiveSpeed()
	return speed * speedScale
end

local function refreshSpeedLabel()
	-- 显示两者：用户单位和实际速度，便于调试
	speedLabel.Text = string.format("速度：%.0f  (实速：%.1f)", speed, effectiveSpeed())
end
refreshSpeedLabel()

-- ===== 创建/清理 BV/BG =====
local function createBVBG(hrp)
	local newBV = Instance.new("BodyVelocity")
	newBV.Name = "VIPFly_BV"
	newBV.MaxForce = Vector3.new(1e5,1e5,1e5)
	newBV.P = 1e4
	newBV.Velocity = Vector3.new(0,0,0)
	newBV.Parent = hrp

	local newBG = Instance.new("BodyGyro")
	newBG.Name = "VIPFly_BG"
	newBG.MaxTorque = Vector3.new(1e5,1e5,1e5)
	newBG.P = 1e4
	newBG.CFrame = hrp.CFrame
	newBG.Parent = hrp

	return newBV, newBG
end

local function clearFlightObjects(char)
	if char then
		local hrp = char:FindFirstChild("HumanoidRootPart")
		if hrp then
			for _, v in ipairs(hrp:GetChildren()) do
				if v.Name == "VIPFly_BV" or v.Name == "VIPFly_BG" then
					v:Destroy()
				end
			end
		end
	end
	if renderConn and renderConn.Connected then
		renderConn:Disconnect()
		renderConn = nil
	end
	if charRemovingConn and charRemovingConn.Connected then
		charRemovingConn:Disconnect()
		charRemovingConn = nil
	end
end

-- ===== 飞行启动/停止（使用 Humanoid.MoveDirection + 摄像机朝向） =====
local function startFlying()
	if flying then return end
	local char = player.Character or player.CharacterAdded:Wait()
	local humanoid = char:FindFirstChildOfClass("Humanoid")
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not humanoid or not hrp then return end

	-- 在此插入你的 VIP 检查（如需要）
	-- if not isPlayerVIP(player) then return end

	clearFlightObjects(char)

	bv, bg = createBVBG(hrp)
	local prevPlatformStand = humanoid.PlatformStand
	humanoid.PlatformStand = true

	renderConn = RunService.RenderStepped:Connect(function()
		if not char or not char.Parent then return end

		local cam = workspace.CurrentCamera
		local moveDir = humanoid.MoveDirection
		local camForwardH = Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z)
		if camForwardH.Magnitude == 0 then camForwardH = Vector3.new(0,0,-1) end
		camForwardH = camForwardH.Unit
		local camRightH = Vector3.new(cam.CFrame.RightVector.X, 0, cam.CFrame.RightVector.Z)
		if camRightH.Magnitude == 0 then camRightH = Vector3.new(1,0,0) end
		camRightH = camRightH.Unit

		local inputX = moveDir:Dot(camRightH)
		local inputZ = moveDir:Dot(camForwardH)

		local camRightFull = cam.CFrame.RightVector
		local camForwardFull = cam.CFrame.LookVector

		local finalDir = (camRightFull * inputX) + (camForwardFull * inputZ)
		local finalVel
		local eff = effectiveSpeed()
		if finalDir.Magnitude > 0.001 then
			finalVel = finalDir.Unit * eff
		else
			finalVel = Vector3.new(0,0,0)
		end

		if bv and bv.Parent then
			bv.Velocity = finalVel
		end
		if bg and bg.Parent then
			bg.CFrame = CFrame.new(hrp.Position, hrp.Position + cam.CFrame.LookVector)
		end
	end)

	charRemovingConn = player.CharacterRemoving:Connect(function()
		if humanoid and humanoid.Parent then
			humanoid.PlatformStand = prevPlatformStand
		end
		clearFlightObjects(char)
		flying = false
		toggleBtn.Text = "环绕阴乐开发 · 开启飞行"
	end)

	flying = true
	toggleBtn.Text = "环绕阴乐开发 · 飞行中"
end

local function stopFlying()
	if not flying then return end
	local char = player.Character
	if char then
		local humanoid = char:FindFirstChildOfClass("Humanoid")
		if humanoid then humanoid.PlatformStand = false end
		clearFlightObjects(char)
	end
	flying = false
	toggleBtn.Text = "环绕阴乐开发 · 开启飞行"
end

-- ===== UI 事件 =====
toggleBtn.MouseButton1Click:Connect(function()
	if flying then
		stopFlying()
	else
		startFlying()
	end
end)

minusBtn.MouseButton1Click:Connect(function()
	speed = math.max(minSpeed, speed - speedStep)
	refreshSpeedLabel()
end)
plusBtn.MouseButton1Click:Connect(function()
	speed = math.min(maxSpeed, speed + speedStep)
	refreshSpeedLabel()
end)

-- 清理保护
screenGui.AncestryChanged:Connect(function(_, parent)
	if not parent and flying then
		stopFlying()
	end
end)

