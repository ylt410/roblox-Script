-- ======================================================
-- 保存响应
-- ======================================================
local function saveResponse(content, prefix, extraInfo)
    if typeof(content) ~= "string" then
        return
    end

    if #content < minRecordLength then
        return
    end

    local hash = getHash(prefix .. "\n" .. content)

    if savedResponseHashes[hash] then
        return
    end

    savedResponseHashes[hash] = true
    responseCount = responseCount + 1

    local timeShort = os.date("%H:%M:%S")
    local timestamp = os.date("%Y%m%d_%H%M%S")

    local filename =
        folderName ..
        "/Responses/" ..
        timestamp ..
        "_" ..
        tostring(prefix) ..
        "_" ..
        tostring(responseCount) ..
        ".lua"

    local finalText =
        "-- 时间: " .. timestamp .. "\n" ..
        "-- 类型: 响应 / " .. tostring(prefix) .. "\n" ..
        tostring(extraInfo or "") .. "\n\n" ..
        content

    pcall(function()
        writefile(filename, finalText)
    end)

    local itemIndex = responseCount

    responseItems[itemIndex] = {
        Text = finalText,
        Prefix = prefix,
        Time = timeShort,
        File = filename,
        Length = #content,
    }

    ResponseTab:Button({
        Title = "#" .. tostring(itemIndex) .. " [" .. tostring(prefix) .. "] " .. timeShort,
        Desc = tostring(#content) .. " 字 | " .. filename,
        Locked = false,

        Callback = function()
            local item = responseItems[itemIndex]

            if item then
                openPreviewWindow(
                    "响应 #" .. tostring(itemIndex) .. " [" .. tostring(item.Prefix) .. "]",
                    item.Text
                )
            end
        end
    })

    updateStatus()

    print("✅ 已保存响应:", filename)
end

-- ======================================================
-- 保存请求
-- ======================================================
local function saveRequest(req, sourceName)
    if typeof(req) ~= "table" then
        return
    end

    local url = safeToString(req.Url or req.URL or req.url or "未知")
    local method = safeToString(req.Method or req.method or "GET")
    local body = safeToString(req.Body or req.body or "")
    local headers = req.Headers or req.headers or {}

    local requestText =
        "-- 请求来源: " .. tostring(sourceName) .. "\n" ..
        "-- Method: " .. tostring(method) .. "\n" ..
        "-- URL: " .. tostring(url) .. "\n\n" ..
        "===== Headers =====\n" ..
        serializeTable(headers) ..
        "\n\n===== Body =====\n" ..
        tostring(body)

    if #requestText < minRecordLength then
        return
    end

    local hash = getHash(requestText)

    if savedRequestHashes[hash] then
        return
    end

    savedRequestHashes[hash] = true
    requestCount = requestCount + 1

    local timeShort = os.date("%H:%M:%S")
    local timestamp = os.date("%Y%m%d_%H%M%S")

    local filename =
        folderName ..
        "/Requests/" ..
        timestamp ..
        "_" ..
        tostring(sourceName) ..
        "_" ..
        tostring(requestCount) ..
        ".txt"

    local finalText =
        "-- 时间: " .. timestamp .. "\n" ..
        "-- 类型: 请求 / " .. tostring(sourceName) .. "\n\n" ..
        requestText

    pcall(function()
        writefile(filename, finalText)
    end)

    local itemIndex = requestCount

    requestItems[itemIndex] = {
        Text = finalText,
        Source = sourceName,
        Method = method,
        Url = url,
        Time = timeShort,
        File = filename,
        Length = #requestText,
    }

    RequestTab:Button({
        Title = "#" .. tostring(itemIndex) .. " [" .. tostring(method) .. "] " .. timeShort,
        Desc = tostring(#requestText) .. " 字 | " .. tostring(url),
        Locked = false,

        Callback = function()
            local item = requestItems[itemIndex]

            if item then
                openPreviewWindow(
                    "请求 #" .. tostring(itemIndex) .. " [" .. tostring(item.Method) .. "]",
                    item.Text
                )
            end
        end
    })

    updateStatus()

    print("✅ 已保存请求:", filename)
end

