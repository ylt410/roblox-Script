local function serializeTable(tbl, depth)
    depth = depth or 0

    if depth > 3 then
        return "{ ... }"
    end

    if typeof(tbl) ~= "table" then
        return safeToString(tbl)
    end

    local lines = {}

    for k, v in pairs(tbl) do
        local keyText = safeToString(k)
        local valueText

        if typeof(v) == "table" then
            valueText = serializeTable(v, depth + 1)
        else
            valueText = safeToString(v)
        end

        table.insert(lines, keyText .. " = " .. valueText)
    end

    if #lines == 0 then
        return "<空>"
    end

    return table.concat(lines, "\n")
end

