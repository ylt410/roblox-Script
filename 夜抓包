-- ==================== 安全函数 ====================
local function safeToString(value)
    local ok, result = pcall(function()
        return tostring(value)
    end)

    if ok then
        return result
    end

    return "<无法转换>"
end

local function clamp(value, minValue, maxValue)
    if value < minValue then
        return minValue
    end

    if value > maxValue then
        return maxValue
    end

    return value
end

local function getHash(str)
    str = tostring(str or "")

    local length = #str
    local firstPart = str:sub(1, 160)
    local middlePart = ""
    local lastPart = ""

    if length > 320 then
        local middleStart = math.max(1, math.floor(length / 2) - 80)
        middlePart = str:sub(middleStart, middleStart + 160)
        lastPart = str:sub(math.max(1, length - 160), length)
    else
        lastPart = str:sub(161)
    end

    local checksum = 0
    local step = math.max(1, math.floor(length / 512))

    for i = 1, length, step do
        local byteValue = string.byte(str, i) or 0
        checksum = (checksum + byteValue * i) % 1000000007
    end

    return tostring(length)
        .. "_"
        .. tostring(checksum)
        .. "_"
        .. firstPart
        .. "_"
        .. middlePart
        .. "_"
        .. lastPart
end

