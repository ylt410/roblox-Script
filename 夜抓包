-- ======================================================
-- 文件名美化 / 智能识别
-- ======================================================
local function sanitizeFilePart(value, maxLength)
    value = tostring(value or "未知")
    maxLength = maxLength or 48

    value = value:gsub("\r", " ")
    value = value:gsub("\n", " ")
    value = value:gsub("\t", " ")
    value = value:gsub("[\\/:*?\"<>|]", "_")
    value = value:gsub("%s+", "_")
    value = value:gsub("_+", "_")
    value = value:gsub("^_+", "")
    value = value:gsub("_+$", "")

    if value == "" then
        value = "未知"
    end

    if #value > maxLength then
        value = value:sub(1, maxLength)
        value = value:gsub("_+$", "")
    end

    if value == "" then
        value = "未知"
    end

    return value
end

local function extractAddress(url)
    url = tostring(url or "")

    if url == "" or url == "nil" or url == "未知" then
        return "未知地址"
    end

    local host = url:match("^[%w_%-]+://([^/%?#]+)")

    if not host then
        host = url:match("^([^/%?#]+)")
    end

    host = tostring(host or "未知地址")
    host = host:gsub("^www%.", "")

    return sanitizeFilePart(host, 48)
end

local function countPlain(text, needle)
    text = tostring(text or "")
    needle = tostring(needle or "")

    if needle == "" then
        return 0
    end

    local count = 0
    local startIndex = 1

    while true do
        local found = string.find(text, needle, startIndex, true)

        if not found then
            break
        end

        count = count + 1
        startIndex = found + #needle
    end

    return count
end

local function analyzeCapturedContent(content)
    content = tostring(content or "")

    local lower = string.lower(content)
    local reasons = {}
    local score = 0

    local function addReason(reason, addScore)
        table.insert(reasons, reason)
        score = score + (addScore or 1)
    end

    local function hasPlain(needle, reason, addScore)
        if string.find(lower, string.lower(needle), 1, true) then
            addReason(reason, addScore)
        end
    end

    hasPlain("obfuscator", "检测到 Obfuscator", 5)
    hasPlain("moonsec", "检测到 MoonSec", 4)
    hasPlain("luraph", "检测到 Luraph", 4)
    hasPlain("ironbrew", "检测到 IronBrew", 4)
    hasPlain("prometheus", "检测到 Prometheus", 3)
    hasPlain("string.char", "检测到 string.char 拼接特征", 2)
    hasPlain("bit32.bxor", "检测到 bit32.bxor 异或特征", 2)
    hasPlain("debug.getupvalue", "检测到 debug.getupvalue", 2)
    hasPlain("debug.setupvalue", "检测到 debug.setupvalue", 2)
    hasPlain("getfenv", "检测到 getfenv", 1)
    hasPlain("setfenv", "检测到 setfenv", 1)
    hasPlain("table.concat", "检测到 table.concat 拼接特征", 1)

    local slashNumberCount = 0

    for _ in string.gmatch(content, "\\%d%d%d") do
        slashNumberCount = slashNumberCount + 1

        if slashNumberCount >= 30 then
            break
        end
    end

    if slashNumberCount >= 30 then
        addReason("检测到大量反斜杠数字转义", 3)
    end

    local loadstringCount = countPlain(lower, "loadstring")

    if loadstringCount >= 3 then
        addReason("loadstring 出现多次", 2)
    end

    local isObfuscated = false

    if score >= 4 then
        isObfuscated = true
    end

    local label = "未发现明显混淆"

    if isObfuscated then
        label = "可能被混淆"
    end

    local reasonText = "无"

    if #reasons > 0 then
        reasonText = table.concat(reasons, "；")
    end

    return {
        IsObfuscated = isObfuscated,
        Label = label,
        ReasonText = reasonText,
        Score = score,
    }
end

local function getChineseTimeForFile()
    return os.date("%Y年%m月%d日_%H时%M分%S秒")
end

local function getChineseTimeForText()
    return os.date("%Y年%m月%d日 %H时%M分%S秒")
end

local function makePrettyFilename(kindChinese, index, sourceName, method, url, analysis, extension)
    kindChinese = sanitizeFilePart(kindChinese or "记录", 16)
    sourceName = sanitizeFilePart(sourceName or "未知来源", 28)
    method = sanitizeFilePart(method or "", 12)
    extension = extension or ".txt"

    local indexText = string.format("%03d", tonumber(index) or 0)
    local timeText = getChineseTimeForFile()
    local addressText = extractAddress(url)

    local flagText = ""

    if analysis and analysis.IsObfuscated then
        flagText = "_可能被混淆"
    end

    if method ~= "" then
        return kindChinese ..
            "_" ..
            indexText ..
            "_" ..
            method ..
            "_来源" ..
            sourceName ..
            "_地址" ..
            addressText ..
            "_" ..
            timeText ..
            flagText ..
            extension
    end

    return kindChinese ..
        "_" ..
        indexText ..
        "_来源" ..
        sourceName ..
        "_地址" ..
        addressText ..
        "_" ..
        timeText ..
        flagText ..
        extension
end

