local function makeDisplaySafeText(text)
    text = tostring(text or "")
    text = text:gsub(string.char(0), "\\0")

    local pattern =
        "[" ..
        string.char(1) ..
        "-" ..
        string.char(8) ..
        string.char(11) ..
        string.char(12) ..
        string.char(14) ..
        "-" ..
        string.char(31) ..
        "]"

    text = text:gsub(pattern, ".")

    return text
end

local function buildSafePreviewText(fullText)
    fullText = tostring(fullText or "-- 空内容")

    local originalLength = #fullText
    local truncated = false
    local reasons = {}

    local limitedText = fullText

    if #limitedText > MAX_PREVIEW_CHARS then
        limitedText = limitedText:sub(1, MAX_PREVIEW_CHARS)
        truncated = true
        table.insert(reasons, "总字符超过 " .. tostring(MAX_PREVIEW_CHARS))
    end

    limitedText = makeDisplaySafeText(limitedText)

    local lines = {}
    local lineCount = 0

    for line in string.gmatch(limitedText .. "\n", "(.-)\n") do
        lineCount = lineCount + 1

        if lineCount > MAX_PREVIEW_LINES then
            truncated = true
            table.insert(reasons, "行数超过 " .. tostring(MAX_PREVIEW_LINES))
            break
        end

        if #line > MAX_PREVIEW_LINE_CHARS then
            line = line:sub(1, MAX_PREVIEW_LINE_CHARS) .. " ... [本行过长，预览已截断]"
            truncated = true
            table.insert(reasons, "单行超过 " .. tostring(MAX_PREVIEW_LINE_CHARS) .. " 字符")
        end

        table.insert(lines, line)
    end

    local displayText = table.concat(lines, "\n")

    if displayText == "" then
        displayText = "-- 空内容"
    end

    if truncated then
        local reasonText = table.concat(reasons, "；")

        if reasonText == "" then
            reasonText = "未知原因"
        end

        displayText =
            "-- ⚠️ 内容过长，预览已自动截断\n" ..
            "-- 原始长度: " .. tostring(originalLength) .. " 字符\n" ..
            "-- 截断原因: " .. reasonText .. "\n" ..
            "-- 复制按钮仍然复制完整内容，不是只复制预览内容\n" ..
            "-- 文件也已经完整保存，不影响抓包结果\n\n" ..
            displayText ..
            "\n\n-- ⚠️ 后续内容未在预览中显示，但完整内容仍可复制 / 已保存到文件"
    end

    return displayText, truncated
end

local function safeGetTextSize(text, textSize, font)
    text = tostring(text or " ")

    if text == "" then
        text = " "
    end

    local sample = text

    if #sample > MAX_MEASURE_SAMPLE_CHARS then
        sample = sample:sub(1, MAX_MEASURE_SAMPLE_CHARS)
    end

    local ok, measured = pcall(function()
        return TextService:GetTextSize(
            sample,
            textSize,
            font,
            Vector2.new(1000000, 1000000)
        )
    end)

    if ok and measured then
        if #text > #sample and #sample > 0 then
            local avg = measured.X / #sample
            return Vector2.new(avg * #text, measured.Y)
        end

        return measured
    end

    return Vector2.new(#text * 8, textSize + 4)
end

local function getMaxScroll()
    local viewSize = codeViewport.AbsoluteSize
    local maxX = math.max(0, contentWidth - viewSize.X)
    local maxY = math.max(0, contentHeight - viewSize.Y)

    return maxX, maxY
end

local function updateCodePosition()
    codeText.Position = UDim2.new(0, -math.floor(scrollX), 0, -math.floor(scrollY))
end

local function updateScrollbars()
    local viewSize = codeViewport.AbsoluteSize
    local maxX, maxY = getMaxScroll()

    if maxY > 1 and contentHeight > 1 and viewSize.Y > 1 then
        verticalTrack.Visible = true

        local trackH = math.max(1, verticalTrack.AbsoluteSize.Y)
        local thumbH = math.max(28, trackH * (viewSize.Y / contentHeight))
        thumbH = math.min(trackH, thumbH)

        local travelH = math.max(0, trackH - thumbH)
        local ratioY = 0

        if maxY > 0 then
            ratioY = clamp(scrollY / maxY, 0, 1)
        end

        verticalThumb.Size = UDim2.new(1, 0, 0, thumbH)
        verticalThumb.Position = UDim2.new(0, 0, 0, ratioY * travelH)
    else
        verticalTrack.Visible = false
        verticalThumb.Position = UDim2.new(0, 0, 0, 0)
    end

    if maxX > 1 and contentWidth > 1 and viewSize.X > 1 then
        horizontalTrack.Visible = true

        local trackW = math.max(1, horizontalTrack.AbsoluteSize.X)
        local thumbW = math.max(28, trackW * (viewSize.X / contentWidth))
        thumbW = math.min(trackW, thumbW)

        local travelW = math.max(0, trackW - thumbW)
        local ratioX = 0

        if maxX > 0 then
            ratioX = clamp(scrollX / maxX, 0, 1)
        end

        horizontalThumb.Size = UDim2.new(0, thumbW, 1, 0)
        horizontalThumb.Position = UDim2.new(0, ratioX * travelW, 0, 0)
    else
        horizontalTrack.Visible = false
        horizontalThumb.Position = UDim2.new(0, 0, 0, 0)
    end
end

local function setScrollPosition(x, y)
    local maxX, maxY = getMaxScroll()

    if x == nil then
        x = scrollX
    end

    if y == nil then
        y = scrollY
    end

    scrollX = clamp(x, 0, maxX)
    scrollY = clamp(y, 0, maxY)

    updateCodePosition()
    updateScrollbars()
end

local function stopInertia()
    if inertiaConnection then
        inertiaConnection:Disconnect()
        inertiaConnection = nil
    end
end

local function startInertia(velocity)
    stopInertia()

    scrollVelocity = velocity

    local friction = 10.5
    local minSpeed = 10

    inertiaConnection = RunService.RenderStepped:Connect(function(dt)
        if scrollVelocity.Magnitude < minSpeed then
            stopInertia()
            return
        end

        local maxX, maxY = getMaxScroll()

        local nextX = scrollX + scrollVelocity.X * dt
        local nextY = scrollY + scrollVelocity.Y * dt

        if nextX < 0 or nextX > maxX then
            scrollVelocity = Vector2.new(0, scrollVelocity.Y)
        end

        if nextY < 0 or nextY > maxY then
            scrollVelocity = Vector2.new(scrollVelocity.X, 0)
        end

        setScrollPosition(nextX, nextY)

        scrollVelocity = scrollVelocity * math.exp(-friction * dt)
    end)
end

local function updateCodeCanvas(text)
    text = tostring(text or "-- 空内容")

    local font = Enum.Font.Code
    local textSize = 14
    local paddingX = 40
    local paddingY = 40

    local viewSize = codeViewport.AbsoluteSize
    local minWidth = math.max(1, viewSize.X)
    local minHeight = math.max(1, viewSize.Y)

    local maxLineWidth = 0
    local lineCount = 0
    local measuredLines = 0

    for line in string.gmatch(text .. "\n", "(.-)\n") do
        lineCount = lineCount + 1

        if measuredLines < MAX_MEASURE_LINES then
            measuredLines = measuredLines + 1

            if line == "" then
                line = " "
            end

            local measured = safeGetTextSize(line, textSize, font)

            if measured.X > maxLineWidth then
                maxLineWidth = measured.X
            end
        end
    end

    if lineCount < 1 then
        lineCount = 1
    end

    local lineMeasured = safeGetTextSize("A", textSize, font)
    local lineHeight = lineMeasured.Y + 3

    contentWidth = math.max(minWidth, math.ceil(maxLineWidth + paddingX))
    contentHeight = math.max(minHeight, math.ceil(lineCount * lineHeight + paddingY))

    contentWidth = math.min(contentWidth, MAX_CANVAS_WIDTH)
    contentHeight = math.min(contentHeight, MAX_CANVAS_HEIGHT)

    codeText.Size = UDim2.new(0, contentWidth, 0, contentHeight)

    setScrollPosition(0, 0)
    updateScrollbars()
end

