local function isInsideGuiObject(input, obj)
    local pos = obj.AbsolutePosition
    local size = obj.AbsoluteSize
    local mousePos = input.Position

    if mousePos.X < pos.X then
        return false
    end

    if mousePos.X > pos.X + size.X then
        return false
    end

    if mousePos.Y < pos.Y then
        return false
    end

    if mousePos.Y > pos.Y + size.Y then
        return false
    end

    return true
end

