local function normalizePath(path)
    path = tostring(path or "")
    path = path:gsub("\\", "/")
    return path
end

local function isInsideCaptureFolder(path)
    local normalizedPath = normalizePath(path)
    local normalizedRoot = normalizePath(folderName)

    if normalizedPath == normalizedRoot then
        return true
    end

    if normalizedPath:sub(1, #normalizedRoot + 1) == normalizedRoot .. "/" then
        return true
    end

    if normalizedPath:find("/" .. normalizedRoot .. "/", 1, true) then
        return true
    end

    return false
end

local function deleteCapturePath(path)
    path = tostring(path or "")

    if path == "" then
        return
    end

    if not isInsideCaptureFolder(path) then
        warn("⚠️ 拒绝删除非抓包目录路径:", path)
        return
    end

    pcall(function()
        if isfile and isfile(path) then
            delfile(path)
            return
        end

        if isfolder and isfolder(path) then
            local children = {}

            pcall(function()
                if listfiles then
                    children = listfiles(path)
                end
            end)

            for _, child in ipairs(children) do
                deleteCapturePath(child)
            end

            if path ~= folderName and delfolder then
                delfolder(path)
            end
        end
    end)
end

local function fileStillExists(item)
    if not item then
        return false
    end

    if not item.FileSaved then
        return true
    end

    if not item.File then
        return true
    end

    if not isfile then
        return true
    end

    return isfile(item.File)
end

