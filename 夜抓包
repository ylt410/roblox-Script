local function destroyElement(element)
    if not element then
        return
    end

    pcall(function()
        if element.Destroy then
            element:Destroy()
        end
    end)
end

local function recalculateCounts()
    local r = 0
    local q = 0

    for _, item in pairs(responseItems) do
        if item then
            r = r + 1
        end
    end

    for _, item in pairs(requestItems) do
        if item then
            q = q + 1
        end
    end

    responseCount = r
    requestCount = q
end

local function removeResponseItem(index, deleteFile)
    local item = responseItems[index]

    if item and deleteFile and item.FileSaved and item.File then
        deleteCapturePath(item.File)
    end

    destroyElement(responseButtons[index])

    responseItems[index] = nil
    responseButtons[index] = nil
end

local function removeRequestItem(index, deleteFile)
    local item = requestItems[index]

    if item and deleteFile and item.FileSaved and item.File then
        deleteCapturePath(item.File)
    end

    destroyElement(requestButtons[index])

    requestItems[index] = nil
    requestButtons[index] = nil
end

syncRecordsWithFiles = function()
    local changed = false

    if isfile then
        for index, item in pairs(responseItems) do
            if item and item.FileSaved and item.File and not isfile(item.File) then
                destroyElement(responseButtons[index])
                responseItems[index] = nil
                responseButtons[index] = nil
                changed = true
            end
        end

        for index, item in pairs(requestItems) do
            if item and item.FileSaved and item.File and not isfile(item.File) then
                destroyElement(requestButtons[index])
                requestItems[index] = nil
                requestButtons[index] = nil
                changed = true
            end
        end
    end

    if changed then
        recalculateCounts()
    end
end

local function clearTypeRecords(kind, deleteFiles)
    if kind == "response" then
        for index, _ in pairs(responseItems) do
            removeResponseItem(index, deleteFiles)
        end

        responseItems = {}
        responseButtons = {}
        savedResponseHashes = {}
        savedResponseContentHashes = {}
        responseCount = 0
        responseNextIndex = 0
    end

    if kind == "request" then
        for index, _ in pairs(requestItems) do
            removeRequestItem(index, deleteFiles)
        end

        requestItems = {}
        requestButtons = {}
        savedRequestHashes = {}
        requestCount = 0
        requestNextIndex = 0
    end

    captureSessionId = captureSessionId + 1

    if updateStatus then
        updateStatus(true)
    end
end

local function clearCapturedFolderInternal()
    local ok = pcall(function()
        ensureFolder(folderName)

        local children = {}

        if listfiles then
            children = listfiles(folderName)
        end

        for _, child in ipairs(children) do
            deleteCapturePath(child)
        end

        ensureFolder(folderName)
        ensureFolder(folderName .. "/Responses")
        ensureFolder(folderName .. "/Requests")
    end)

    clearTypeRecords("response", false)
    clearTypeRecords("request", false)

    if not ok then
        warn("⚠️ 清空失败：当前环境可能不支持 listfiles / delfile / delfolder")
        return false
    end

    print("✅ 已清空抓包文件夹内容:", folderName)
    return true
end

