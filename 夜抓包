-- ======================================================
-- 保存响应
-- ======================================================
local function saveResponse(content, prefix, extraInfo, sourceUrl)
    if typeof(content) ~= "string" then
        return
    end

    if #content < minRecordLength then
        return
    end

    local contentHash = getHash(content)
    local sourceHash = getHash(prefix .. "\n" .. tostring(sourceUrl or "") .. "\n" .. content)

    -- 跨来源内容去重：
    -- 修复 loadstring(game:HttpGet(...)) 同时被 HttpGet 和 Loadstring 记录的问题。
    if savedResponseContentHashes[contentHash] then
        print("ℹ️ 已跳过重复响应内容:", tostring(prefix))
        return
    end

    if savedResponseHashes[sourceHash] then
        return
    end

    savedResponseContentHashes[contentHash] = true
    savedResponseHashes[sourceHash] = true

    responseNextIndex = responseNextIndex + 1
    responseCount = responseCount + 1

    local itemIndex = responseNextIndex
    local analysis = analyzeCapturedContent(content)

    local timeShort = os.date("%H:%M:%S")
    local timestamp = getChineseTimeForText()

    local filename = makePrettyFilename(
        "响应",
        itemIndex,
        prefix,
        "",
        sourceUrl or prefix,
        analysis,
        ".lua"
    )

    local fullPath = folderName .. "/Responses/" .. filename

    local finalText =
        "-- 时间: " .. timestamp .. "\n" ..
        "-- 类型: 响应 / " .. tostring(prefix) .. "\n" ..
        "-- 智能识别: " .. tostring(analysis.Label) .. "\n" ..
        "-- 识别原因: " .. tostring(analysis.ReasonText) .. "\n" ..
        "-- 文件名: " .. tostring(filename) .. "\n" ..
        tostring(extraInfo or "") .. "\n\n" ..
        content

    local fileSaved = false

    pcall(function()
        writefile(fullPath, finalText)
        fileSaved = true
    end)

    local itemSession = captureSessionId
    local obfTitle = ""

    if analysis.IsObfuscated then
        obfTitle = " ⚠可能混淆"
    end

    responseItems[itemIndex] = {
        Text = finalText,
        Prefix = prefix,
        Time = timeShort,
        File = fullPath,
        Filename = filename,
        Length = #content,
        Analysis = analysis,
        Session = itemSession,
        FileSaved = fileSaved,
    }

    responseButtons[itemIndex] = ResponseTab:Button({
        Title = "#" .. string.format("%03d", itemIndex) .. " 响应 [" .. tostring(prefix) .. "]" .. obfTitle .. " " .. timeShort,
        Desc = tostring(#content) .. " 字 | " .. tostring(analysis.Label) .. " | " .. filename,
        Locked = false,

        Callback = function()
            local item = responseItems[itemIndex]

            if item and item.Session == captureSessionId and fileStillExists(item) then
                openPreviewWindow(
                    "响应 #" .. string.format("%03d", itemIndex) .. " [" .. tostring(item.Prefix) .. "]",
                    item.Text
                )
            else
                removeResponseItem(itemIndex, false)
                recalculateCounts()
                updateStatus(true)
                warn("⚠️ 该响应记录已被清空或本地文件已不存在，UI 已同步移除")
            end
        end
    })

    updateStatus()

    if fileSaved then
        print("✅ 已保存响应:", fullPath)
    else
        warn("⚠️ 响应已记录到 UI，但写入文件失败")
    end

    if analysis.IsObfuscated then
        warn("⚠️ 智能识别：该响应可能被混淆 |", analysis.ReasonText)
    end
end

-- ======================================================
-- 保存请求
-- ======================================================
local function saveRequest(req, sourceName)
    if typeof(req) ~= "table" then
        return
    end

    local url = safeToString(req.Url or req.URL or req.url or "未知")
    local method = safeToString(req.Method or req.method or "GET")
    local body = safeToString(req.Body or req.body or "")
    local headers = req.Headers or req.headers or {}

    local requestText =
        "-- 请求来源: " .. tostring(sourceName) .. "\n" ..
        "-- Method: " .. tostring(method) .. "\n" ..
        "-- URL: " .. tostring(url) .. "\n\n" ..
        "===== Headers =====\n" ..
        serializeTable(headers) ..
        "\n\n===== Body =====\n" ..
        tostring(body)

    if #requestText < minRecordLength then
        return
    end

    local hash = getHash(requestText)

    if savedRequestHashes[hash] then
        return
    end

    savedRequestHashes[hash] = true

    requestNextIndex = requestNextIndex + 1
    requestCount = requestCount + 1

    local itemIndex = requestNextIndex
    local analysis = analyzeCapturedContent(requestText)

    local timeShort = os.date("%H:%M:%S")
    local timestamp = getChineseTimeForText()

    local filename = makePrettyFilename(
        "请求",
        itemIndex,
        sourceName,
        method,
        url,
        analysis,
        ".txt"
    )

    local fullPath = folderName .. "/Requests/" .. filename

    local finalText =
        "-- 时间: " .. timestamp .. "\n" ..
        "-- 类型: 请求 / " .. tostring(sourceName) .. "\n" ..
        "-- 智能识别: " .. tostring(analysis.Label) .. "\n" ..
        "-- 识别原因: " .. tostring(analysis.ReasonText) .. "\n" ..
        "-- 文件名: " .. tostring(filename) .. "\n\n" ..
        requestText

    local fileSaved = false

    pcall(function()
        writefile(fullPath, finalText)
        fileSaved = true
    end)

    local itemSession = captureSessionId
    local obfTitle = ""

    if analysis.IsObfuscated then
        obfTitle = " ⚠可能混淆"
    end

    requestItems[itemIndex] = {
        Text = finalText,
        Source = sourceName,
        Method = method,
        Url = url,
        Time = timeShort,
        File = fullPath,
        Filename = filename,
        Length = #requestText,
        Analysis = analysis,
        Session = itemSession,
        FileSaved = fileSaved,
    }

    requestButtons[itemIndex] = RequestTab:Button({
        Title = "#" .. string.format("%03d", itemIndex) .. " 请求 [" .. tostring(method) .. "]" .. obfTitle .. " " .. timeShort,
        Desc = tostring(#requestText) .. " 字 | " .. tostring(analysis.Label) .. " | " .. filename,
        Locked = false,

        Callback = function()
            local item = requestItems[itemIndex]

            if item and item.Session == captureSessionId and fileStillExists(item) then
                openPreviewWindow(
                    "请求 #" .. string.format("%03d", itemIndex) .. " [" .. tostring(item.Method) .. "]",
                    item.Text
                )
            else
                removeRequestItem(itemIndex, false)
                recalculateCounts()
                updateStatus(true)
                warn("⚠️ 该请求记录已被清空或本地文件已不存在，UI 已同步移除")
            end
        end
    })

    updateStatus()

    if fileSaved then
        print("✅ 已保存请求:", fullPath)
    else
        warn("⚠️ 请求已记录到 UI，但写入文件失败")
    end

    if analysis.IsObfuscated then
        warn("⚠️ 智能识别：该请求可能包含混淆内容 |", analysis.ReasonText)
    end
end

-- ======================================================
-- Hook loadstring
-- ======================================================
pcall(function()
    if loadstring and hookfunction and clonefunction then
        local oldLoadstring = clonefunction(loadstring)

        hookfunction(loadstring, function(code, chunkname)
            if isCapturing then
                saveResponse(
                    code,
                    "Loadstring",
                    "-- Chunk: " .. tostring(chunkname),
                    tostring(chunkname or "loadstring")
                )
            end

            return oldLoadstring(code, chunkname)
        end)
    end
end)

-- ======================================================
-- Hook HttpGet / HttpGetAsync 响应
-- ======================================================
local function hookHttp(name, func)
    pcall(function()
        if func and hookfunction and clonefunction then
            local oldFunc = clonefunction(func)

            hookfunction(func, function(self, url, ...)
                local result = oldFunc(self, url, ...)

                if isCapturing and typeof(result) == "string" then
                    saveResponse(
                        result,
                        name,
                        "-- URL: " .. tostring(url),
                        tostring(url)
                    )
                end

                return result
            end)
        end
    end)
end

pcall(function()
    hookHttp("HttpGet", game.HttpGet)
end)

pcall(function()
    hookHttp("HttpGetAsync", game.HttpGetAsync)
end)

-- ======================================================
-- Hook request / http_request / syn.request
-- 同时抓请求 + 响应
-- ======================================================
local function hookRequest(name, func)
    pcall(function()
        if func and hookfunction and clonefunction then
            local oldFunc = clonefunction(func)

            hookfunction(func, function(req)
                if isCapturing then
                    saveRequest(req, name)
                end

                local resp = oldFunc(req)

                if isCapturing then
                    if typeof(resp) == "table" then
                        if typeof(resp.Body) == "string" then
                            local urlText = "未知"

                            pcall(function()
                                urlText = tostring(req.Url or req.URL or req.url)
                            end)

                            saveResponse(
                                resp.Body,
                                name,
                                "-- URL: " .. tostring(urlText),
                                tostring(urlText)
                            )
                        end
                    end
                end

                return resp
            end)
        end
    end)
end

pcall(function()
    hookRequest("http_request", http_request)
end)

pcall(function()
    hookRequest("request", request)
end)

pcall(function()
    if syn and syn.request then
        hookRequest("syn.request", syn.request)
    end
end)

