        task.delay(1, function()
            if copyBtn then
                copyBtn.Text = "复制"
            end
        end)

        print("✅ 已复制当前内容")
    else
        copyBtn.Text = "失败"

        task.delay(1, function()
            if copyBtn then
                copyBtn.Text = "复制"
            end
        end)

        warn("⚠️ 当前环境不支持 setclipboard")
    end
end)

local function openPreviewWindow(title, text)
    title = tostring(title or "预览")
    text = tostring(text or "-- 空内容")

    stopInertia()

    currentOpenedText = text

    previewGui.Enabled = true
    previewWindow.Visible = true
    previewWindow.Position = UDim2.new(0.5, -260, 0.5, -160)

    previewTitle.Text = title
    codeText.Text = text

    task.defer(function()
        updateCodeCanvas(text)
        setScrollPosition(0, 0)
    end)

    print("✅ 已打开预览窗口:", title)
end

codeViewport:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
    if currentOpenedText and currentOpenedText ~= "" then
        updateCodeCanvas(currentOpenedText)
    end
end)

