local function getMaxScroll()
    local viewSize = codeViewport.AbsoluteSize
    local maxX = math.max(0, contentWidth - viewSize.X)
    local maxY = math.max(0, contentHeight - viewSize.Y)
    return maxX, maxY
end

local function updateCodePosition()
    codeText.Position = UDim2.new(0, -math.floor(scrollX), 0, -math.floor(scrollY))
end

local function updateScrollbars()
    local viewSize = codeViewport.AbsoluteSize
    local maxX, maxY = getMaxScroll()

    if maxY > 1 and contentHeight > 1 and viewSize.Y > 1 then
        verticalTrack.Visible = true

        local trackH = math.max(1, verticalTrack.AbsoluteSize.Y)
        local thumbH = math.max(28, trackH * (viewSize.Y / contentHeight))
        thumbH = math.min(trackH, thumbH)

        local travelH = math.max(0, trackH - thumbH)
        local ratioY = 0

        if maxY > 0 then
            ratioY = clamp(scrollY / maxY, 0, 1)
        end

        verticalThumb.Size = UDim2.new(1, 0, 0, thumbH)
        verticalThumb.Position = UDim2.new(0, 0, 0, ratioY * travelH)
    else
        verticalTrack.Visible = false
        verticalThumb.Position = UDim2.new(0, 0, 0, 0)
    end

    if maxX > 1 and contentWidth > 1 and viewSize.X > 1 then
        horizontalTrack.Visible = true

        local trackW = math.max(1, horizontalTrack.AbsoluteSize.X)
        local thumbW = math.max(28, trackW * (viewSize.X / contentWidth))
        thumbW = math.min(trackW, thumbW)

        local travelW = math.max(0, trackW - thumbW)
        local ratioX = 0

        if maxX > 0 then
            ratioX = clamp(scrollX / maxX, 0, 1)
        end

        horizontalThumb.Size = UDim2.new(0, thumbW, 1, 0)
        horizontalThumb.Position = UDim2.new(0, ratioX * travelW, 0, 0)
    else
        horizontalTrack.Visible = false
        horizontalThumb.Position = UDim2.new(0, 0, 0, 0)
    end
end

local function setScrollPosition(x, y)
    local maxX, maxY = getMaxScroll()

    if x == nil then
        x = scrollX
    end

    if y == nil then
        y = scrollY
    end

    scrollX = clamp(x, 0, maxX)
    scrollY = clamp(y, 0, maxY)

    updateCodePosition()
    updateScrollbars()
end

local function stopInertia()
    if inertiaConnection then
        inertiaConnection:Disconnect()
        inertiaConnection = nil
    end
end

local function startInertia(velocity)
    stopInertia()

    scrollVelocity = velocity

    local friction = 10.5
    local minSpeed = 10

    inertiaConnection = RunService.RenderStepped:Connect(function(dt)
        if scrollVelocity.Magnitude < minSpeed then
            stopInertia()
            return
        end

        local maxX, maxY = getMaxScroll()

        local nextX = scrollX + scrollVelocity.X * dt
        local nextY = scrollY + scrollVelocity.Y * dt

        if nextX < 0 or nextX > maxX then
            scrollVelocity = Vector2.new(0, scrollVelocity.Y)
        end

        if nextY < 0 or nextY > maxY then
            scrollVelocity = Vector2.new(scrollVelocity.X, 0)
        end

        setScrollPosition(nextX, nextY)

        scrollVelocity = scrollVelocity * math.exp(-friction * dt)
    end)
end

local function updateCodeCanvas(text)
    text = tostring(text or "-- 空内容")

    local font = Enum.Font.Code
    local textSize = 14
    local paddingX = 40
    local paddingY = 40

    local viewSize = codeViewport.AbsoluteSize
    local minWidth = math.max(1, viewSize.X)
    local minHeight = math.max(1, viewSize.Y)

    local maxLineWidth = 0
    local lineCount = 0

    for line in string.gmatch(text .. "\n", "(.-)\n") do
        lineCount = lineCount + 1

        if line == "" then
            line = " "
        end

        local measured = TextService:GetTextSize(
            line,
            textSize,
            font,
            Vector2.new(1000000, 1000000)
        )

        if measured.X > maxLineWidth then
            maxLineWidth = measured.X
        end
    end

    if lineCount < 1 then
        lineCount = 1
    end

    local lineMeasured = TextService:GetTextSize(
        "A",
        textSize,
        font,
        Vector2.new(1000000, 1000000)
    )

    local lineHeight = lineMeasured.Y + 3

    contentWidth = math.max(minWidth, math.ceil(maxLineWidth + paddingX))
    contentHeight = math.max(minHeight, math.ceil(lineCount * lineHeight + paddingY))

    codeText.Size = UDim2.new(0, contentWidth, 0, contentHeight)

    setScrollPosition(0, 0)
    updateScrollbars()
end

-- ======================================================
-- 代码区域拖动 + 惯性
-- ======================================================
codeViewport.InputBegan:Connect(function(input)
    if isPointerInput(input) then
        stopInertia()

        contentDragging = true
        contentDragStart = input.Position
        contentStartX = scrollX
        contentStartY = scrollY
        lastContentPos = input.Position
        lastContentTime = tick()
        scrollVelocity = Vector2.new(0, 0)

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                if contentDragging then
                    contentDragging = false

                    if scrollVelocity.Magnitude > 35 then
                        startInertia(scrollVelocity)
                    end
                end
            end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if contentDragging and isMoveInput(input) then
        local now = tick()
        local dt = math.max(now - lastContentTime, 1 / 240)

        local deltaFromStart = input.Position - contentDragStart

        local targetX = contentStartX - deltaFromStart.X
        local targetY = contentStartY - deltaFromStart.Y

        setScrollPosition(targetX, targetY)

        local deltaNow = input.Position - lastContentPos

        scrollVelocity = Vector2.new(
            -deltaNow.X / dt,
            -deltaNow.Y / dt
        )

        lastContentPos = input.Position
        lastContentTime = now
    end
end)

-- ======================================================
-- 横竖滚动条统一拖动
-- ======================================================
local function beginBarDrag(axis, input)
    stopInertia()

    barDragging = true
    barAxis = axis
    barDragStart = input.Position
    barStartScrollX = scrollX
    barStartScrollY = scrollY

    input.Changed:Connect(function()
        if input.UserInputState == Enum.UserInputState.End then
            barDragging = false
            barAxis = nil
        end
    end)
end

local function updateBarDrag(input)
    if not barDragging then
        return
    end

    if not barAxis then
        return
    end

    if not barDragStart then
        return
    end

    local maxX, maxY = getMaxScroll()

    if barAxis == "X" then
        local trackW = math.max(1, horizontalTrack.AbsoluteSize.X)
        local thumbW = math.max(1, horizontalThumb.AbsoluteSize.X)
        local travelW = math.max(1, trackW - thumbW)

        local deltaX = input.Position.X - barDragStart.X
        local targetX = barStartScrollX + (deltaX / travelW) * maxX

        setScrollPosition(targetX, scrollY)
    end

    if barAxis == "Y" then
        local trackH = math.max(1, verticalTrack.AbsoluteSize.Y)
        local thumbH = math.max(1, verticalThumb.AbsoluteSize.Y)
        local travelH = math.max(1, trackH - thumbH)

        local deltaY = input.Position.Y - barDragStart.Y
        local targetY = barStartScrollY + (deltaY / travelH) * maxY

        setScrollPosition(scrollX, targetY)
    end
end

horizontalThumb.InputBegan:Connect(function(input)
    if isPointerInput(input) then
        beginBarDrag("X", input)
    end
end)

verticalThumb.InputBegan:Connect(function(input)
    if isPointerInput(input) then
        beginBarDrag("Y", input)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if barDragging and isMoveInput(input) then
        updateBarDrag(input)
    end
end)

local function jumpHorizontalTrack(input)
    local maxX, maxY = getMaxScroll()

    if maxX <= 0 then
        return
    end

    local trackX = horizontalTrack.AbsolutePosition.X
    local trackW = math.max(1, horizontalTrack.AbsoluteSize.X)
    local thumbW = math.max(1, horizontalThumb.AbsoluteSize.X)
    local travelW = math.max(1, trackW - thumbW)

    local localX = input.Position.X - trackX
    local targetThumbX = clamp(localX - thumbW / 2, 0, travelW)
    local ratio = targetThumbX / travelW

    setScrollPosition(ratio * maxX, scrollY)
end

local function jumpVerticalTrack(input)
    local maxX, maxY = getMaxScroll()

    if maxY <= 0 then
        return
    end

    local trackY = verticalTrack.AbsolutePosition.Y
    local trackH = math.max(1, verticalTrack.AbsoluteSize.Y)
    local thumbH = math.max(1, verticalThumb.AbsoluteSize.Y)
    local travelH = math.max(1, trackH - thumbH)

    local localY = input.Position.Y - trackY
    local targetThumbY = clamp(localY - thumbH / 2, 0, travelH)
    local ratio = targetThumbY / travelH

    setScrollPosition(scrollX, ratio * maxY)
end

horizontalTrack.InputBegan:Connect(function(input)
    if isPointerInput(input) then
        stopInertia()
        jumpHorizontalTrack(input)
        beginBarDrag("X", input)
    end
end)

verticalTrack.InputBegan:Connect(function(input)
    if isPointerInput(input) then
        stopInertia()
        jumpVerticalTrack(input)
        beginBarDrag("Y", input)
    end
end)

