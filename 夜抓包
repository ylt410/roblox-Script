local function isInsideGuiObject(input, obj)
    local pos = obj.AbsolutePosition
    local size = obj.AbsoluteSize
    local mousePos = input.Position

    if mousePos.X < pos.X then
        return false
    end

    if mousePos.X > pos.X + size.X then
        return false
    end

    if mousePos.Y < pos.Y then
        return false
    end

    if mousePos.Y > pos.Y + size.Y then
        return false
    end

    return true
end

previewTopBar.InputBegan:Connect(function(input)
    if isPointerInput(input) then
        if isInsideGuiObject(input, closePreviewBtn) then
            return
        end

        if isInsideGuiObject(input, copyBtn) then
            return
        end

        previewDragging = true
        previewDragStart = input.Position
        previewStartPos = previewWindow.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                previewDragging = false
            end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if previewDragging and isMoveInput(input) then
        local delta = input.Position - previewDragStart

        previewWindow.Position = UDim2.new(
            previewStartPos.X.Scale,
            previewStartPos.X.Offset + delta.X,
            previewStartPos.Y.Scale,
            previewStartPos.Y.Offset + delta.Y
        )
    end
end)

