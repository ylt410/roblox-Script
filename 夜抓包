local currentOpenedText = ""

local contentWidth = 500
local contentHeight = 260
local scrollX = 0
local scrollY = 0

local contentDragging = false
local contentDragStart = nil
local contentStartX = 0
local contentStartY = 0
local lastContentPos = nil
local lastContentTime = 0
local scrollVelocity = Vector2.new(0, 0)
local inertiaConnection = nil

local barDragging = false
