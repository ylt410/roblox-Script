codeViewport.InputBegan:Connect(function(input)
    if isPointerInput(input) then
        if not beginExclusiveDrag("content", input) then
            return
        end

        stopInertia()
        forceStopBarDrag()
        forceStopPreviewDrag()

        contentDragging = true
        contentDragStart = input.Position
        contentStartX = scrollX
        contentStartY = scrollY
        lastContentPos = input.Position
        lastContentTime = tick()
        scrollVelocity = Vector2.new(0, 0)

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                if activeDragMode == "content" and contentDragging then
                    local velocity = scrollVelocity

                    forceStopContentDrag()
                    endExclusiveDrag("content")

                    if velocity.Magnitude > 35 then
                        startInertia(velocity)
                    end
                end
            end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if contentDragging and isActiveMoveInput(input, "content") then
        local now = tick()
        local dt = math.max(now - lastContentTime, 1 / 240)

        local deltaFromStart = input.Position - contentDragStart

        local targetX = contentStartX - deltaFromStart.X
        local targetY = contentStartY - deltaFromStart.Y

        setScrollPosition(targetX, targetY)

        local deltaNow = input.Position - lastContentPos

        scrollVelocity = Vector2.new(
            -deltaNow.X / dt,
            -deltaNow.Y / dt
        )

        lastContentPos = input.Position
        lastContentTime = now
    end
end)

