local function KeyCodeFromString(keyName, fallback)
    fallback = fallback or Enum.KeyCode.RightAlt

    if typeof(keyName) == "EnumItem" then
        return keyName
    end

    if type(keyName) == "string" then
        local cleaned = tostring(keyName):gsub("^Enum%.KeyCode%.", "")

        if Enum.KeyCode[cleaned] then
            return Enum.KeyCode[cleaned]
        end
    end

    return fallback
end

local function NormalizeSliderValue(value, fallback)
    if typeof(value) == "number" then
        return value
    end

    if type(value) == "string" then
        local n = tonumber(value)
        if n then
            return n
        end
    end

    if type(value) == "table" then
        local n =
            tonumber(value.Value)
            or tonumber(value.value)
            or tonumber(value.Default)
            or tonumber(value.default)

        if n then
            return n
        end
    end

    return fallback
end

local function CloneArray(list)
    local result = {}

    if type(list) ~= "table" then
        return result
    end

    for _, value in ipairs(list) do
        table.insert(result, value)
    end

    return result
end

local function RemoveFromTable(list, value)
    if type(list) ~= "table" then
        return
    end

    for i = #list, 1, -1 do
        if list[i] == value then
            table.remove(list, i)
        end
    end
end

local function MakeProxy(defaultValue)
    local proxy = {
        Value = defaultValue,
        Values = nil,
        _element = nil,
    }

    function proxy:SetValue(value)
        self.Value = value

        if self._element then
            pcall(function()
                self._element:Set(value)
            end)

            pcall(function()
                self._element:SetValue(value)
            end)

            pcall(function()
                self._element:Select(value)
            end)
        end
    end

    function proxy:SetValues(values, selected)
        if type(values) ~= "table" then
            values = {}
        end

        self.Values = values

        if self._element then
            pcall(function()
                self._element:Refresh(values)
            end)
        end

        if selected ~= nil then
            self:SetValue(selected)
        end
    end

    return proxy
end

local function AddToggle(parent, key, data, callback)
    local defaultValue = data.Value == true
    local proxy = MakeProxy(defaultValue)
    Toggles[key] = proxy

    local config = {
        Title = data.Title or key,
        Icon = data.Icon,
        Value = defaultValue,
        Flag = key,
        Callback = function(value)
            proxy.Value = value

            if callback then
                callback(value)
            end
        end,
    }

    if data.Type then
        config.Type = data.Type
    end

    local element = parent:Toggle(config)
    proxy._element = element

    return proxy
end

local function AddSlider(parent, key, data, callback)
    local defaultValue = tonumber(data.Default) or 0
    local proxy = MakeProxy(defaultValue)
    Options[key] = proxy

    local element = parent:Slider({
        Title = data.Title or key,
        Step = data.Step or 1,
        Value = {
            Min = data.Min,
            Max = data.Max,
            Default = defaultValue,
        },
        Flag = key,
        Callback = function(value)
            local numericValue = NormalizeSliderValue(value, proxy.Value or defaultValue)

            proxy.Value = numericValue

            if callback then
                callback(numericValue)
            end
        end,
    })

    proxy._element = element

    return proxy
end

