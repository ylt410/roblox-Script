local RunService = game:GetService("RunService")

local AntiFallEnabled = false
local AntiFallConnection

local function AntiFall(character)

    local root = character:WaitForChild("HumanoidRootPart")

    local lastY = root.Position.Y

    AntiFallConnection = RunService.Heartbeat:Connect(function()

        if not AntiFallEnabled then return end

        local current = root.Position

        local fall = lastY - current.Y

        if fall >= 14 then

            local vel = root.AssemblyLinearVelocity

            root.CFrame = root.CFrame * CFrame.new(0,-0.5,0)

            root.AssemblyLinearVelocity = Vector3.new(
                vel.X,
                -10,
                vel.Z
            )

            lastY = root.Position.Y

        end

        if current.Y > lastY then
            lastY = current.Y
        end

    end)

end

